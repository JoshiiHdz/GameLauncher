<UserControl x:Class="GameLauncher.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Centred in its area in every theme: the Grid is held to the page width and a stretched element that is capped sits in the middle. -->
    <Grid MaxWidth="{DynamicResource PageBodyMaxWidth}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,12" beh:Motion.FadeIn="True">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding DriveSummary}" FontSize="12" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="#26F5A524"
                    Visibility="{Binding HasWarning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding WarningText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5A524" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,8" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" beh:Motion.FadeIn="True">
            <StackPanel>
                <TextBlock Text="No games are installed on this drive." FontSize="12" Opacity="0.6"
                           Visibility="{Binding Snapshot.HasNoRows, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Snapshot.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Height="5" Margin="0,5,0,3" Minimum="0" Maximum="1" beh:Motion.AnimatedValue="{Binding Fraction, Mode=OneWay}"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource TrackFill}" />
                                    <TextBlock Text="{Binding ShareText}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Transparent" BorderThickness="0" Margin="8,0,0,0"
                                           VerticalAlignment="Top" ToolTip="Open install location"
                                           Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenFolder_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Snapshot.UnmeasuredText}" FontSize="12" Opacity="0.7" Margin="0,0,0,4"
                           Visibility="{Binding Snapshot.HasUnmeasured, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding Snapshot.GamesTotalText}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Snapshot.OtherText}" FontSize="12" Opacity="0.7" Margin="0,2,0,0"
                           Visibility="{Binding Snapshot.HasOther, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Text="Sizes are approximate - shared files and compression can change what a game really takes on disk."
                           FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,8,12,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
