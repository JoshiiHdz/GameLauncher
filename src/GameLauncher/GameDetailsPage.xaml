<UserControl x:Class="GameLauncher.GameDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FactLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DesignMuted}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="FactValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MaxWidth="1000" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,8,28,22" beh:Motion.FadeIn="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="170" Height="255" CornerRadius="10" Margin="0,0,26,0" VerticalAlignment="Top"
                    Background="{StaticResource DesignBg2}" ClipToBounds="True">
                <Grid DataContext="{Binding Game}">
                    <ui:SymbolIcon Symbol="Games24" FontSize="30" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                    <Border Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"
                                        AlignmentX="Center" AlignmentY="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Icon}" Width="56" Height="56" Stretch="Uniform"
                           Visibility="{Binding IsCoverArt, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Game.Name}" FontSize="26" FontWeight="Bold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" Margin="0,0,0,14" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Launcher" Style="{StaticResource FactLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource FactValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Installed in" Style="{StaticResource FactLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.InstallDir}" Style="{StaticResource FactValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Size on disk" Style="{StaticResource FactLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource FactValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Play time" Style="{StaticResource FactLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlayTimeText}" Style="{StaticResource FactValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Added" Style="{StaticResource FactLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AddedText}" Style="{StaticResource FactValueStyle}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Collections" Style="{StaticResource FactLabelStyle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CollectionsText}" Style="{StaticResource FactValueStyle}" Margin="0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="2" Content="Edit..." Click="EditCollections_Click" Padding="12,4" />
                </Grid>

                <!-- Notes: the user's own words about the game. Saved when this page closes. -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Your notes" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ui:TextBox Grid.Row="1" x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Where you left off, mods you use, settings that work... saved when you close this page."
                                AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                VerticalContentAlignment="Top" MaxLength="{Binding NotesLimit}" MinHeight="90" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                               Padding="20,9" FontWeight="SemiBold" Click="Play_Click" />
                    <ui:Button Content="Open install location" Icon="{ui:SymbolIcon FolderOpen24}" Margin="10,0,0,0" Padding="16,9"
                               Click="OpenFolder_Click" />
                    <ui:Button Content="Uninstall..." Icon="{ui:SymbolIcon Delete24}" Margin="10,0,0,0" Padding="16,9"
                               ToolTip="Opens this game's launcher so you can uninstall it there."
                               Click="Uninstall_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
