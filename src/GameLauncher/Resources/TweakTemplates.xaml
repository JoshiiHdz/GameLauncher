<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:GameLauncher.Converters">

    <!-- One game tweak, the same wherever it is listed: its name, one line saying what Windows has right now (in the accent colour when Windows already has it that way),
         "Details" for what it is, what it does and what it needs, and the switch. The switch shows ON when Windows already has the setting on - it is on while a game
         runs - and then cannot be moved, because there is nothing to choose. -->
    <DataTemplate x:Key="TweakRowTemplate">
        <Border Padding="0,7,0,7" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding WindowsState}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowsState}" Margin="0,1,0,0"
                                   Visibility="{Binding HasWindowsState, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlreadyApplied}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Content="Details" IsChecked="{Binding ShowDetails, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" Padding="8,2"
                                  FontSize="11.5" MinWidth="0" MinHeight="0" ToolTip="What it is, what it does and what it needs" />
                    <ui:ToggleSwitch Grid.Column="2" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding ShownOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="0,6,0,2" Visibility="{Binding ShowDetails, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,3,0,0">
                        <Run Text="{Binding Effect, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Requirement, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A small heading above a group of rows. -->
    <Style x:Key="TweakGroupHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
</ResourceDictionary>
