<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GameLauncher.Converters"
                    xmlns:beh="clr-namespace:GameLauncher.Behaviors"
                    xmlns:controls="clr-namespace:GameLauncher.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Merged, not assumed: this dictionary is loaded standalone by the card-wiring tests, so every
         brush it paints with has to come with it rather than from a consuming Window's resources. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GameLauncher;component/Resources/DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Compact card geometry, shared by all library views. Portrait art fills this frame;
         automatic artwork selection prefers an actual portrait rather than zooming a landscape banner. -->
    <!-- (The card's size comes from the theme: ActiveCardWidth x ActiveCardHeight, 156 x 203 in Axis and 120 x 156 in a small window. The rounded clip on
         the artwork is sized to the artwork by ThemeRadius.RoundClip.) -->

    <!-- The one card definition shared by MainWindow's Favorites section, main library grid, and Hidden
         section - and, via this standalone dictionary, by LibraryViewModelGameCardWiringTests, which
         merges this exact file (never a hand-copied approximation of it) to prove the context-menu/Tag
         wiring actually works against the real markup. Self-contained on purpose: every style/converter
         GameCardTemplate itself needs is declared or referenced here, nothing relies on a consuming
         Window's own Resources - StaticResource lookups inside a DataTemplate resolve against the
         dictionary the template was DEFINED in, not the tree that later uses it, so this file has to
         carry its own dependencies to be portable at all. -->

    <conv:BoolToStarConverter x:Key="BoolToStarConverter" />

    <!-- ONE menu definition, used by both the card's right-click menu and its hover "..." button.
         x:Shared="False" hands each reference its own instance (a ContextMenu can only belong to one
         element at a time), which is what lets both share this markup instead of keeping two copies
         that silently drift apart - they did, before this was shared.

         ContextMenu is a separate visual-tree root (a Popup), so bindings inside it can't walk up to
         the Window the way the card's own elements do - PlacementTarget is the only link back. Tag on
         the placement target carries the ViewModel across that gap, and PlacementTarget.DataContext
         supplies that card's own GameEntry as the command parameter. -->
    <ContextMenu x:Key="GameCardContextMenu" x:Shared="False">
        <!-- Name header with a close X: the card behind this menu loses its hover highlight the moment the mouse reaches the (separately rooted) popup,
             so this row still says which game is about to be acted on. No Command: clicking the row (the X included) just closes the menu like any other
             plain item; Tag="MenuHeader" lets tests find it without matching the game's name. -->
        <MenuItem Tag="MenuHeader" FontWeight="SemiBold">
            <MenuItem.Template>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" beh:ThemeRadius.Key="RadiusMenuRow" Padding="10,0,0,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <!-- No row highlight: only the X lights up (below), so the header reads as a label with a close button, not as a menu row. -->
                </ControlTemplate>
            </MenuItem.Template>
            <MenuItem.Header>
                <Grid MinWidth="220" Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MenuHeaderName" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Border Grid.Column="1" Width="1" Margin="0,8" Background="{DynamicResource Muted}" Opacity="0.4" />
                    <Border Grid.Column="2" Width="30" Height="26" Margin="0,0,4,0" beh:ThemeRadius.Key="RadiusMenuRow" ToolTip="Close menu">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface2}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Header="Play"
                  Command="{Binding PlacementTarget.Tag.LaunchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Game details..."
                  Command="{Binding PlacementTarget.Tag.ShowGameDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="{Binding PlacementTarget.DataContext.Favorite, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={x:Static conv:FavoriteToMenuTextConverter.Instance}}"
                  Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="{Binding PlacementTarget.DataContext.Hidden, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={x:Static conv:HiddenToMenuTextConverter.Instance}}"
                  Command="{Binding PlacementTarget.Tag.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Collections..."
                  Command="{Binding PlacementTarget.Tag.EditCollectionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="Change Cover Manually"
                  Command="{Binding PlacementTarget.Tag.ChangeCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Reset cover to automatic"
                  Command="{Binding PlacementTarget.Tag.ResetCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <!-- Identity and artwork are two separate decisions: "Identify game" says WHICH game this is, the cover rows above pick an IMAGE and never change identity. -->
        <MenuItem Header="Identify game..."
                  Command="{Binding PlacementTarget.Tag.IdentifyGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="Open install location"
                  Command="{Binding PlacementTarget.Tag.OpenInstallLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <!-- Hands off to the game's own launcher; Axis never deletes game files itself. -->
        <MenuItem Header="Uninstall..." Tag="Destructive" Foreground="{DynamicResource Danger}"
                  Command="{Binding PlacementTarget.Tag.UninstallGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>

    <!-- Hover motion is a short, one-shot render transform; it never changes layout or loops. -->
    <!-- A bare-template plain Button, deliberately not ui:Button. WPF-UI's button paints its own
         square-cornered background in its normal AND hover visual states, which showed through
         the card's rounded corners as a pale hard-cornered frame. Setting Appearance,
         Background, BorderBrush and CornerRadius did not reach the hover layer. Stripping the
         template to a ContentPresenter removes every bit of that chrome for good - the card's
         own Border draws the entire visual, and HoverOverlay provides the hover feedback. -->
    <Style x:Key="GameCardStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The FALLBACK exe icon only: small and centred, never stretched into a blurry mess. Real cover
         art is painted by GameCoverFillBrush below instead of by this Image - see its remarks. -->
    <Style x:Key="GameArtImageStyle" TargetType="Image">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Same reasoning as GameCardStyle: bare template, no third-party chrome to leak square
         corners or stray highlights. Lives on the ART now (top-right), not the caption strip -
         the caption is plain text only now; see the card's own remarks on where Favorite/Hidden
         moved to. -->
    <Style x:Key="FavoriteStarStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#E6FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ArtPlate}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Favorite}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Star}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One card definition shared by the Favorites section and the main library grid (the Axis card, spec 03 section 3.3): a poster with the favourite star at the top
         right and a launcher pill at the bottom left, then the name and "Steam · 1.5 h · Today" underneath. Hovering lifts it 2 px; keyboard focus draws a ring around
         the art. Everything the card could do before still works: a click plays the game (the Axis way of opening a game), the hover overlay, the menu button, the
         star and the right-click menu. -->
    <DataTemplate x:Key="GameCardTemplate">
        <Button x:Name="CardButton" Style="{StaticResource GameCardStyle}"
                   Margin="0,0,16,22" Width="{DynamicResource ActiveCardWidth}"
                   Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                   CommandParameter="{Binding}"
                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <!-- ContextMenu is a separate visual-tree root (a Popup), so bindings inside it can't walk up to the Window the way the card's own elements do -
                 PlacementTarget is the only link back. Tag carries the ViewModel across that gap and PlacementTarget.DataContext supplies this card's own GameEntry. -->
            <Button.ContextMenu>
                <StaticResource ResourceKey="GameCardContextMenu" />
            </Button.ContextMenu>
            <!-- CardRoot is the hover source (it spans art AND text) but paints nothing; CardMotion is what lifts. -->
            <Border x:Name="CardRoot" Background="Transparent">
                <StackPanel x:Name="CardMotion">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <Grid>
                        <!-- Keyboard focus: a 2 px ring with a 2 px gap, around the art -->
                        <Border x:Name="FocusRing" Margin="-4" beh:ThemeRadius.Key="RadiusCard" BorderBrush="{DynamicResource FocusInk}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="ArtFrame" beh:ThemeRadius.Key="RadiusCard" beh:ThemeRadius.RoundClip="True">
                            <Grid Width="{DynamicResource ActiveCardWidth}" Height="{DynamicResource ActiveCardHeight}">
                                <Border Background="{DynamicResource Bg2}">
                                    <Grid>
                                        <!-- Real cover art fills the frame with a centred crop; portrait-source selection is the resolver's job, not stretching. -->
                                        <Border x:Name="CoverFill"
                                                Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border.Background>
                                        </Border>

                                        <!-- No cover: a gradient plate with the launcher's initials and a note. -->
                                        <Border x:Name="FallbackArt" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                                Visibility="{Binding IsCoverArt, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                                                    <GradientStop Color="#262A36" Offset="0" />
                                                    <GradientStop Color="#181B24" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                                    <controls:LauncherIcon Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="No cover found" Margin="0,8,0,0" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Identity badge (top left): shown only when automatic identification could not settle which game this is. It invites the
                                     user to identify it; it says nothing about the cover being displayed. -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="8,8,0,0" Padding="4,2" CornerRadius="6"
                                        Background="{DynamicResource ArtPlate}"
                                        ToolTip="{Binding IdentityBadgeText}"
                                        Visibility="{Binding NeedsIdentity, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="12" Foreground="#CCFFFFFF" />
                                </Border>

                                <!-- Favourite (top right) and Running (below it): a round plate with the star - always there once favourited, otherwise on hover. -->
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="1">
                                    <Button x:Name="FavoriteButton" Style="{StaticResource FavoriteStarStyle}"
                                               Content="{Binding Favorite, Converter={StaticResource BoolToStarConverter}}"
                                               ToolTip="Favorite" Visibility="Collapsed"
                                               Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}" />

                                    <Border Padding="6,3" CornerRadius="999" Margin="0,4,0,0"
                                            Background="{DynamicResource ArtPlate}" HorizontalAlignment="Right"
                                            Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Text="Running" FontSize="9" FontWeight="SemiBold" Foreground="White" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- The launcher pill (bottom left): an initials chip and the launcher's name on a dark plate, readable on any art. -->
                                <Border x:Name="LauncherPill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Height="22" Padding="3,0,8,0"
                                        beh:ThemeRadius.Key="Pill" Background="{DynamicResource ArtPlate}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LauncherIcon Width="16" Height="16" />
                                        <TextBlock Text="{Binding Source, Converter={x:Static conv:LauncherNameConverter.Instance}}" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Hover reveal: a dimming overlay, a centred round Play button, and the "..." overflow button - all toggled by the SAME CardRoot hover
                                     trigger below, so they can never drift out of sync. Only CardMenuButton is itself interactive. -->
                                <Border x:Name="HoverOverlay" Background="#A6000000" Visibility="Collapsed" IsHitTestVisible="False" />

                                <Border x:Name="HoverPlayButton" Width="40" Height="40" CornerRadius="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed" IsHitTestVisible="False">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{DynamicResource AccentInk}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Overflow "..." menu: the same actions as the right-click menu, discoverable on hover. A Border, not a nested Button (see
                                     ContextMenuButtonBehavior's remarks); Tag/ContextMenu mirror the card's own right-click menu since PlacementTarget here is this Border. -->
                                <Border x:Name="CardMenuButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,8,8" Width="32" Height="32" CornerRadius="8" Background="{StaticResource DesignArtMoreFill}"
                                        Cursor="Hand" Visibility="Collapsed" ToolTip="More options"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        beh:ContextMenuButtonBehavior.OpensContextMenuOnClick="True">
                                    <ui:SymbolIcon Symbol="MoreVertical24" FontSize="14" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border.ContextMenu>
                                        <StaticResource ResourceKey="GameCardContextMenu" />
                                    </Border.ContextMenu>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Name and "Steam · 1.5 h · Today" sit directly on the page background beneath the art, with no panel behind them. The name is held at two
                         lines' height so the rows of a grid stay aligned whether a title wraps or not. -->
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               Margin="0,9,0,0" MaxHeight="40" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="CardMeta" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static conv:GameMetaConverter.Instance}" ConverterParameter="card">
                                <Binding />
                                <Binding Path="TotalPlaySeconds" />
                                <Binding Path="LastPlayedDisplay" />
                                <Binding Path="Source" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- Same title installed through another launcher too: a quiet amber line, so the duplicate is noticed without shouting. -->
                    <TextBlock FontSize="10.5" Foreground="#F5A524" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding DuplicateNote}" ToolTip="{Binding DuplicateNote}"
                               Visibility="{Binding HasDuplicate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    <!-- Storage information belongs to the selected-drive view, never on the artwork. -->
                    <Border x:Name="InstallSizePanel" Margin="0,5,0,0" Padding="8,3" CornerRadius="5"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                            ToolTip="Approximate installed file size. Shared files and compression can affect actual disk usage."
                            Visibility="{Binding DataContext.HasSelectedDriveFilter, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="On disk" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="InstallSizeValue" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding InstallSizeDisplay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInstallSize}" Value="False"><Setter Property="Text" Value="Unavailable" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Button>

        <DataTemplate.Triggers>
            <!-- Hover: the card rises 2 px (150 ms, ease-out) and settles back on leave. Skipped when Windows animations are off. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardMotion"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="-2" Duration="{x:Static beh:ThemeTiming.Hover}" EasingFunction="{x:Static beh:ThemeTiming.EaseStandard}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardMotion"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="0" Duration="{x:Static beh:ThemeTiming.Hover}" EasingFunction="{x:Static beh:ThemeTiming.EaseStandard}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                <Setter TargetName="HoverPlayButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="CardMenuButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="CardButton" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="CardButton" Property="IsPressed" Value="True">
                <Setter TargetName="ArtFrame" Property="Opacity" Value="0.85" />
            </Trigger>
            <DataTrigger Binding="{Binding Favorite}" Value="True">
                <Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
