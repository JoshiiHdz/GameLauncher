<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GameLauncher.Converters"
                    xmlns:beh="clr-namespace:GameLauncher.Behaviors"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The card's size lives HERE, once. The three numbers that used to be repeated below (the button width, the art height and the
         rounded-corner clip) drifted apart too easily to widen a card by hand. Art height doesn't have to match a fixed 2:3 ratio - it's
         tuned on its own so the box isn't taller than real cover art actually needs; the caption strip is 30 high, so the clip is
         width x (art + 30). -->
    <sys:Double x:Key="GameCardWidth">200</sys:Double>
    <sys:Double x:Key="GameCardArtHeight">260</sys:Double>
    <Rect x:Key="GameCardClipRect">0,0,200,290</Rect>

    <!-- The one card definition shared by MainWindow's Favorites section, main library grid, and Hidden
         section - and, via this standalone dictionary, by LibraryViewModelGameCardWiringTests, which
         merges this exact file (never a hand-copied approximation of it) to prove the context-menu/Tag
         wiring actually works against the real markup. Self-contained on purpose: every style/converter
         GameCardTemplate itself needs is declared or referenced here, nothing relies on a consuming
         Window's own Resources - StaticResource lookups inside a DataTemplate resolve against the
         dictionary the template was DEFINED in, not the tree that later uses it, so this file has to
         carry its own dependencies to be portable at all. -->

    <conv:BoolToStarConverter x:Key="BoolToStarConverter" />

    <!-- Hover/selection states are plain property triggers - no Storyboards or timers, so the
         app costs effectively nothing while idle or while a game is running. -->
    <!-- A bare-template plain Button, deliberately not ui:Button. WPF-UI's button paints its own
         square-cornered background in its normal AND hover visual states, which showed through
         the card's rounded corners as a pale hard-cornered frame. Setting Appearance,
         Background, BorderBrush and CornerRadius did not reach the hover layer. Stripping the
         template to a ContentPresenter removes every bit of that chrome for good - the card's
         own Border draws the entire visual, and HoverOverlay provides the hover feedback. -->
    <Style x:Key="GameCardStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A fallback exe icon stays small and centered so it isn't stretched into a blurry mess. Real cover art fills the tile's LAYOUT
         SLOT (Stretch=Stretch on the Image element itself) but is drawn with Stretch=Uniform, never UniformToFill: some real covers
         (SteamGridDB in particular allows several aspect ratios - banners as well as posters) are not the tile's own shape, and
         UniformToFill was silently CROPPING those - the artwork's own edges get cut off, not a layout bug. Uniform never crops; a
         mismatched aspect ratio letterboxes against ControlFillColorSecondaryBrush (the same background the exe-icon fallback sits on)
         instead of losing part of the image. -->
    <Style x:Key="GameArtImageStyle" TargetType="Image">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCoverArt}" Value="True">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="NaN" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Same reasoning as GameCardStyle: bare template, no third-party chrome to leak square
         corners or stray highlights into the caption strip. -->
    <Style x:Key="FavoriteStarStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#A6FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Favorite}" Value="True">
                <Setter Property="Foreground" Value="#FFC83D" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Same bare-template shape as FavoriteStarStyle, without the Favorite-specific color swap -
         this one hosts the hide/unhide glyph pair instead of a single star character. -->
    <Style x:Key="CardIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#A6FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One card definition shared by the Favorites section and the main library grid -->
    <DataTemplate x:Key="GameCardTemplate">
        <Button Style="{StaticResource GameCardStyle}"
                   Margin="0,0,12,14" Width="{StaticResource GameCardWidth}"
                   Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                   CommandParameter="{Binding}"
                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <!-- ContextMenu is a separate visual-tree root (a Popup), so bindings inside it can't
                 walk up to the Window the way the card's own elements do above - PlacementTarget is
                 the only link back. Tag carries the ViewModel across that gap (set via the normal
                 AncestorType=Window walk, which still works here since Tag itself lives on the
                 Button, inside the ordinary visual tree) and PlacementTarget.DataContext supplies
                 this card's own GameEntry as the command parameter, the same value `{Binding}` above
                 resolves to. -->
            <Button.ContextMenu>
                <ContextMenu>
                    <!-- Name header: the card behind this menu can lose its own hover highlight the moment the mouse
                         moves onto the (separately-rooted) popup, so this is the one thing in the menu itself that
                         still says which game is about to be edited. No Command - clicking anywhere on the row
                         (including the "x") just closes the menu, like any other plain MenuItem click; Tag="MenuHeader"
                         is only so tests can find this one row without matching on its (game-specific) text. -->
                    <MenuItem Tag="MenuHeader" FontWeight="SemiBold">
                        <MenuItem.Header>
                            <Grid MinWidth="150">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MenuHeaderName" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"
                                           Text="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <TextBlock Grid.Column="1" Text="✕" FontSize="11" Opacity="0.65" VerticalAlignment="Center" ToolTip="Close menu" />
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Change Cover..."
                              Command="{Binding PlacementTarget.Tag.ChangeCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Reset Cover to Automatic"
                              Command="{Binding PlacementTarget.Tag.ResetCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <!-- Identity and artwork are two separate decisions: "Identify Game" says WHICH game this is,
                         "Choose Cover from Catalog" picks an IMAGE (a custom cover) and never changes identity. -->
                    <MenuItem Header="Identify Game..."
                              Command="{Binding PlacementTarget.Tag.IdentifyGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Choose Cover from Catalog..."
                              Command="{Binding PlacementTarget.Tag.ChooseCatalogCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </Button.ContextMenu>
            <Border x:Name="CardRoot" CornerRadius="8" Background="#33000000">
                <!-- Explicit clip so the caption strip's bottom corners round too, not just the art -->
                <Border.Clip>
                    <RectangleGeometry Rect="{StaticResource GameCardClipRect}" RadiusX="8" RadiusY="8" />
                </Border.Clip>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Width="{StaticResource GameCardWidth}" Height="{StaticResource GameCardArtHeight}">
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Games24" FontSize="34" Opacity="0.35"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                <Image Source="{Binding Icon}"
                                       Style="{StaticResource GameArtImageStyle}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

        <!-- Platform badge: the launcher's own icon, or a small muted glyph when the source
             is unknown - kept subtle so it marks the cover rather than blotting it out. -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="5,5,0,0" Padding="2" CornerRadius="4"
                                Background="#8C000000"
                                ToolTip="{Binding Source, Converter={x:Static conv:GameSourceDisplayConverter.Instance}}">
                            <Grid Width="14" Height="14">
                                <Image Source="{Binding PlatformIcon}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- Hardcoded Xbox logo: its MSIX package icon can never be
                                     extracted, so PlatformIcon is always null for an Xbox game -
                                     this fills that same slot with the real logo instead of the
                                     generic fallback glyph below. -->
                                <Image Source="/Assets/XboxLogo.png" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Visibility>
                                        <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForXboxLogo}">
                                            <Binding Path="Source" />
                                            <Binding Path="PlatformIcon" />
                                        </MultiBinding>
                                    </Image.Visibility>
                                </Image>
                                <ui:SymbolIcon Symbol="{Binding Source, Converter={x:Static conv:GameSourceToFallbackSymbolConverter.Instance}}"
                                               FontSize="10" Foreground="#8CFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Visibility>
                                        <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForFallbackSymbol}">
                                            <Binding Path="Source" />
                                            <Binding Path="PlatformIcon" />
                                        </MultiBinding>
                                    </ui:SymbolIcon.Visibility>
                                </ui:SymbolIcon>
                            </Grid>
                        </Border>

                        <!-- Running badge: mirrors the platform badge's placement, opposite corner -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,5,5,0" Padding="6,3" CornerRadius="4"
                                Background="#8C000000"
                                Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Running" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Identity badge: shown only when automatic identification could not settle which game this is.
                             It invites the user to identify it; it says nothing about the cover being displayed. -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="5,0,0,5" Padding="4,2" CornerRadius="4"
                                Background="#8C000000"
                                ToolTip="{Binding IdentityBadgeText}"
                                Visibility="{Binding NeedsIdentity, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="12" Foreground="#CCFFFFFF" />
                        </Border>

                        <!-- Hover reveal: Visibility swap on a property trigger, no animation loop -->
                        <Border x:Name="HoverOverlay" Background="#A6000000" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Play24" FontSize="28" HorizontalAlignment="Center" Foreground="White" />
                                <TextBlock Text="Play" FontWeight="SemiBold" FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Overflow "..." menu: the same actions already on the right-click menu below, just
                             discoverable on hover without knowing to right-click. A Border, not a nested Button
                             (see ContextMenuButtonBehavior's remarks) - Tag/ContextMenu bindings mirror the
                             card's own right-click menu exactly, since PlacementTarget here is this Border,
                             not the outer card Button. -->
                        <Border x:Name="CardMenuButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,5,5" Padding="4" CornerRadius="4" Background="#8C000000"
                                Cursor="Hand" Visibility="Collapsed" ToolTip="More options"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                beh:ContextMenuButtonBehavior.OpensContextMenuOnClick="True">
                            <ui:SymbolIcon Symbol="MoreVertical24" FontSize="14" Foreground="White" />
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <!-- Same name header (with its own close "x") as the right-click menu, see its remarks -
                                         the overflow icon is the exact case this matters most for: the card's own hover
                                         highlight is what just disappeared, since the mouse left CardRoot to reach this popup. -->
                                    <MenuItem Tag="MenuHeader" FontWeight="SemiBold">
                                        <MenuItem.Header>
                                            <Grid MinWidth="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <TextBlock Grid.Column="1" Text="✕" FontSize="11" Opacity="0.65" VerticalAlignment="Center" ToolTip="Close menu" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Change Cover..."
                                              Command="{Binding PlacementTarget.Tag.ChangeCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Reset Cover to Automatic"
                                              Command="{Binding PlacementTarget.Tag.ResetCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Identify Game..."
                                              Command="{Binding PlacementTarget.Tag.IdentifyGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Choose Cover from Catalog..."
                                              Command="{Binding PlacementTarget.Tag.ChooseCatalogCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </Grid>

                    <Grid Background="#CC0A0A0A" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="7,0,2,0" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding Name}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Button Grid.Column="1" Style="{StaticResource FavoriteStarStyle}"
                                   Content="{Binding Favorite, Converter={StaticResource BoolToStarConverter}}"
                                   ToolTip="Favorite"
                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}" />

                        <!-- Hide/unhide: same button and command either way, just a different glyph
                             and tooltip depending on which side of the toggle the card is currently on. -->
                        <Button Grid.Column="2" Style="{StaticResource CardIconButtonStyle}"
                                   Margin="0,0,5,0"
                                   ToolTip="{Binding Hidden, Converter={x:Static conv:HiddenToTooltipConverter.Instance}}"
                                   Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}">
                            <Grid Width="14" Height="14">
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="13"
                                               Visibility="{Binding Hidden, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                                <ui:SymbolIcon Symbol="Eye24" FontSize="13"
                                               Visibility="{Binding Hidden, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Button>

        <DataTemplate.Triggers>
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                <Setter TargetName="CardMenuButton" Property="Visibility" Value="Visible" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
