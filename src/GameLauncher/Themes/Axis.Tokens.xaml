    <sys:Double x:Key="HeroTopSmall">0</sys:Double>
    <sys:Double x:Key="FilterColumnWidth">0</sys:Double>
    <sys:Double x:Key="FilterColumnWidthSmall">0</sys:Double>
    <sys:Double x:Key="PaletteTop">56</sys:Double>
    <sys:Double x:Key="PaletteTopSmall">56</sys:Double>


    <!-- Page presentation (spec 06 section 6.5) -->
    <SolidColorBrush x:Key="GroupCardFill" Color="#FF141822" />
    <SolidColorBrush x:Key="GroupCardStroke" Color="#FF262C3A" />
    <SolidColorBrush x:Key="BackButtonFill" Color="#FF141822" />
    <SolidColorBrush x:Key="BackButtonStroke" Color="#FF262C3A" />
    <sys:Double x:Key="BackButtonSize">32</sys:Double>
    <sys:Double x:Key="PageTop">18</sys:Double>
    <sys:Double x:Key="PageSideGutter">28</sys:Double>
    <sys:Double x:Key="PageSideGutterSmall">16</sys:Double>

    <sys:Double x:Key="FontSizeStat">26</sys:Double>
    <FontWeight x:Key="FontWeightStat">Bold</FontWeight>

    <SolidColorBrush x:Key="PaletteFill" Color="#FF141822" />
    <SolidColorBrush x:Key="PaletteStroke" Color="#FF262C3A" />
    <SolidColorBrush x:Key="PaletteLine" Color="#FF262C3A" />

    <SolidColorBrush x:Key="InputFill" Color="#FF070910" />
