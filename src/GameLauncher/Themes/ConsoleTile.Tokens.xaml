<!-- ConsoleTile.Tokens.xaml — generated from 02-tokens.md. Same keys in all three themes. Swap this dictionary to switch theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:motion="clr-namespace:GameLauncher.Behaviors">

    <sys:String x:Key="ThemeId">ConsoleTile</sys:String>

    <!-- Colours -->
    <Color x:Key="BgColor">#FF07080B</Color>
    <Color x:Key="Bg2Color">#FF12141B</Color>
    <Color x:Key="SurfaceColor">#FF1A1D27</Color>
    <Color x:Key="SurfaceTranslucentColor">#E61A1D27</Color>
    <Color x:Key="Surface2Color">#FF22252F</Color>
    <Color x:Key="StrokeColor">#FF2A2D3A</Color>
    <Color x:Key="ChipFillColor">#14FFFFFF</Color>
    <Color x:Key="ChipFillHoverColor">#29FFFFFF</Color>
    <Color x:Key="ChipStrokeColor">#24FFFFFF</Color>
    <Color x:Key="InkColor">#FFFFFFFF</Color>
    <Color x:Key="InkSoftColor">#FFD1D5DB</Color>
    <Color x:Key="MutedColor">#FF9CA3AF</Color>
    <Color x:Key="SubtleColor">#FF9CA3AF</Color>
    <Color x:Key="AccentColor">#FF22C55E</Color>
    <Color x:Key="AccentHoverColor">#FF16A34A</Color>
    <Color x:Key="AccentInkColor">#FF07080B</Color>
    <Color x:Key="AccentTextColor">#FF4ADE80</Color>
    <Color x:Key="AccentGlowColor">#00000000</Color>
    <Color x:Key="AccentSoftFillColor">#2422C55E</Color>
    <Color x:Key="AccentSoftStrokeColor">#0022C55E</Color>
    <Color x:Key="FocusInkColor">#FFFFFFFF</Color>
    <Color x:Key="InverseFillColor">#FFF1F3F9</Color>
    <Color x:Key="InverseInkColor">#FF07080B</Color>
    <Color x:Key="DangerColor">#FFF87171</Color>
    <Color x:Key="DangerSolidColor">#FFEF4444</Color>
    <Color x:Key="DangerFillColor">#1FEF4444</Color>
    <Color x:Key="DangerStrokeColor">#4DEF4444</Color>
    <Color x:Key="StarColor">#FFFBBF24</Color>
    <Color x:Key="ArtPlateColor">#C7000000</Color>
    <Color x:Key="ToggleOffTrackColor">#FF2A2D3A</Color>
    <Color x:Key="ToggleOffKnobColor">#FF9CA3AF</Color>
    <Color x:Key="CheckOffStrokeColor">#FF6B7280</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="ScrimLightColor">#80000000</Color>

    <!-- Brushes (templates use only these) -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceTranslucent" Color="{StaticResource SurfaceTranslucentColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="ChipFill" Color="{StaticResource ChipFillColor}" />
    <SolidColorBrush x:Key="ChipFillHover" Color="{StaticResource ChipFillHoverColor}" />
    <SolidColorBrush x:Key="ChipStroke" Color="{StaticResource ChipStrokeColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentGlow" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="AccentSoftFill" Color="{StaticResource AccentSoftFillColor}" />
    <SolidColorBrush x:Key="AccentSoftStroke" Color="{StaticResource AccentSoftStrokeColor}" />
    <SolidColorBrush x:Key="FocusInk" Color="{StaticResource FocusInkColor}" />
    <SolidColorBrush x:Key="InverseFill" Color="{StaticResource InverseFillColor}" />
    <SolidColorBrush x:Key="InverseInk" Color="{StaticResource InverseInkColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSolid" Color="{StaticResource DangerSolidColor}" />
    <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" />
    <SolidColorBrush x:Key="DangerStroke" Color="{StaticResource DangerStrokeColor}" />
    <SolidColorBrush x:Key="Star" Color="{StaticResource StarColor}" />
    <SolidColorBrush x:Key="ArtPlate" Color="{StaticResource ArtPlateColor}" />
    <SolidColorBrush x:Key="ToggleOffTrack" Color="{StaticResource ToggleOffTrackColor}" />
    <SolidColorBrush x:Key="ToggleOffKnob" Color="{StaticResource ToggleOffKnobColor}" />
    <SolidColorBrush x:Key="CheckOffStroke" Color="{StaticResource CheckOffStrokeColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrimLight" Color="{StaticResource ScrimLightColor}" />

    <!-- WPF-UI accent override: every library control reads the theme accent (01 §1.4) -->
    <Color x:Key="SystemAccentColor">#FF22C55E</Color>
    <Color x:Key="SystemAccentColorPrimary">#FF22C55E</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF22C55E</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF16A34A</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusCard">4</CornerRadius>
    <CornerRadius x:Key="RadiusRibbonItem">4</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">4</CornerRadius>
    <CornerRadius x:Key="RadiusHero">0</CornerRadius>
    <CornerRadius x:Key="RadiusButton">4</CornerRadius>
    <CornerRadius x:Key="RadiusInput">4</CornerRadius>
    <CornerRadius x:Key="RadiusMenu">4</CornerRadius>
    <CornerRadius x:Key="RadiusMenuRow">0</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">0</CornerRadius>
    <CornerRadius x:Key="RadiusPalette">4</CornerRadius>
    <CornerRadius x:Key="RadiusPalRow">0</CornerRadius>
    <CornerRadius x:Key="RadiusNavItem">4</CornerRadius>
    <CornerRadius x:Key="RadiusCheck">2</CornerRadius>
    <CornerRadius x:Key="RadiusPageLayer">0</CornerRadius>
    <CornerRadius x:Key="RadiusSheet">0</CornerRadius>

    <!-- Sizes, spacing, type sizes, depth (0 = not used by this theme) -->
    <sys:Double x:Key="CaptionHeight">32</sys:Double>
    <sys:Double x:Key="TopBarHeight">52</sys:Double>
    <sys:Double x:Key="FooterHeight">0</sys:Double>
    <sys:Double x:Key="SidebarWidth">0</sys:Double>
    <sys:Double x:Key="RailWidth">0</sys:Double>
    <sys:Double x:Key="PageGutter">36</sys:Double>
    <sys:Double x:Key="PageGutterSmall">20</sys:Double>
    <sys:Double x:Key="CardWidth">140</sys:Double>
    <sys:Double x:Key="CardHeight">182</sys:Double>
    <sys:Double x:Key="CardWidthSmall">108</sys:Double>
    <sys:Double x:Key="CardHeightSmall">140</sys:Double>
    <sys:Double x:Key="RibbonItemSize">0</sys:Double>
    <sys:Double x:Key="RibbonItemFocusedSize">0</sys:Double>
    <sys:Double x:Key="RibbonItemSizeSmall">0</sys:Double>
    <sys:Double x:Key="RibbonItemFocusedSizeSmall">0</sys:Double>
    <sys:Double x:Key="ShelfGap">8</sys:Double>
    <sys:Double x:Key="GridGapRow">10</sys:Double>
    <sys:Double x:Key="GridGapColumn">10</sys:Double>
    <sys:Double x:Key="ButtonHeight">38</sys:Double>
    <sys:Double x:Key="HeroButtonHeight">44</sys:Double>
    <sys:Double x:Key="InputHeight">38</sys:Double>
    <sys:Double x:Key="MenuWidth">260</sys:Double>
    <sys:Double x:Key="MenuRowHeight">36</sys:Double>
    <sys:Double x:Key="DialogWidth">400</sys:Double>
    <sys:Double x:Key="PaletteWidth">560</sys:Double>
    <sys:Double x:Key="PaletteWidthSmall">460</sys:Double>
    <sys:Double x:Key="PageBodyMaxWidth">760</sys:Double>
    <sys:Double x:Key="SettingsNavWidth">0</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">46</sys:Double>
    <sys:Double x:Key="FontSizeDisplaySmall">30</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">30</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeGroupTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeNote">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel">11</sys:Double>
    <sys:Double x:Key="FontSizeCardName">13</sys:Double>
    <sys:Double x:Key="FontSizeCardMeta">11</sys:Double>
    <sys:Double x:Key="FontSizeBadge">9</sys:Double>
    <sys:Double x:Key="FocusRingThickness">3</sys:Double>
    <sys:Double x:Key="FocusRingGap">0</sys:Double>
    <sys:Double x:Key="FocusScale">1.06</sys:Double>
    <sys:Double x:Key="HoverLift">0</sys:Double>
    <sys:Double x:Key="RiseDistance">4</sys:Double>
    <sys:Double x:Key="PageRiseDistance">0</sys:Double>
    <sys:Double x:Key="RecedeScale">1</sys:Double>
    <sys:Double x:Key="RecedeDimOpacity">0</sys:Double>
    <sys:Double x:Key="GlowBlurMin">0</sys:Double>
    <sys:Double x:Key="GlowBlurMax">0</sys:Double>

    <!-- Font weights -->
    <FontWeight x:Key="FontWeightDisplay">ExtraBold</FontWeight>
    <FontWeight x:Key="FontWeightPageTitle">ExtraBold</FontWeight>
    <FontWeight x:Key="FontWeightGroupTitle">Bold</FontWeight>
    <FontWeight x:Key="FontWeightCardName">Bold</FontWeight>
    <FontWeight x:Key="FontWeightLabel">Bold</FontWeight>
    <FontFamily x:Key="ThemeFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Durations -->
    <Duration x:Key="DurHover">0:0:00.120</Duration>
    <Duration x:Key="DurFocus">0:0:00.140</Duration>
    <Duration x:Key="DurMenu">0:0:00.120</Duration>
    <Duration x:Key="DurPanel">0:0:00.200</Duration>
    <Duration x:Key="DurDialog">0:0:00.200</Duration>
    <Duration x:Key="DurPage">0:0:00.160</Duration>
    <Duration x:Key="DurBackground">0:0:00.260</Duration>
    <Duration x:Key="DurToast">0:0:00.220</Duration>
    <Duration x:Key="ToastHold">0:0:02.600</Duration>
    <Duration x:Key="DurBar">0:0:00.520</Duration>
    <Duration x:Key="DurBreathe">0:0:00.000</Duration>

    <!-- Easings (BezierEase from xaml/Code/BezierEase.cs) -->
    <motion:BezierEase x:Key="EaseStandard" X1="0.2" Y1="0.8" X2="0.2" Y2="1" />
    <motion:BezierEase x:Key="EaseFocus" X1="0.2" Y1="0.9" X2="0.3" Y2="1.25" />
    <motion:BezierEase x:Key="EaseOutSnap" X1="0.2" Y1="0.8" X2="0.2" Y2="1" />
    <motion:BezierEase x:Key="EaseSoft" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />


    <!-- Additions used by Shared.Styles.xaml and the theme templates (not in 02-tokens.md; same keys in every theme) -->
    <SolidColorBrush x:Key="TrackFill" Color="#14FFFFFF" />
    <Thickness x:Key="FocusRingMargin">-3</Thickness>
    <Thickness x:Key="FocusRingBorder">3</Thickness>
    <CornerRadius x:Key="RadiusBar">1</CornerRadius>
    <x:Null x:Key="PrimaryGlowEffect" />
    <x:Null x:Key="HeroGlowEffect" />
    <x:Null x:Key="ToggleGlowEffect" />
    <x:Null x:Key="BarGlowEffect" />


    <!-- Layout values with their 760x480 ("Small") counterparts; ThemeLayout publishes the right one as Active<Name>. -->
    <sys:Double x:Key="HeroHeight">300</sys:Double>
    <sys:Double x:Key="HeroHeightSmall">150</sys:Double>
    <sys:Double x:Key="ToolTileWidth">124</sys:Double>
    <sys:Double x:Key="ToolTileWidthSmall">104</sys:Double>
    <sys:Double x:Key="ToolTileHeight">96</sys:Double>
    <sys:Double x:Key="ToolTileHeightSmall">80</sys:Double>
    <sys:Double x:Key="GuideWidth">340</sys:Double>
    <sys:Double x:Key="GuideWidthSmall">280</sys:Double>
    <sys:Double x:Key="DialogWidthSmall">320</sys:Double>
    <sys:Double x:Key="SearchWidth">240</sys:Double>
    <sys:Double x:Key="SearchWidthSmall">140</sys:Double>
    <sys:Double x:Key="SettingsTileWidth">124</sys:Double>
    <sys:Double x:Key="SettingsTileWidthSmall">104</sys:Double>
    <sys:Double x:Key="SettingsTileHeight">76</sys:Double>
    <sys:Double x:Key="SettingsTileHeightSmall">68</sys:Double>
    <sys:Double x:Key="SettingsNavWidthSmall">0</sys:Double>
    <sys:Double x:Key="RibbonTop">0</sys:Double>
    <sys:Double x:Key="RibbonTopSmall">0</sys:Double>
    <sys:Double x:Key="HeroTop">0</sys:Double>
    <sys:Double x:Key="HeroTopSmall">0</sys:Double>
    <sys:Double x:Key="FilterColumnWidth">0</sys:Double>
    <sys:Double x:Key="FilterColumnWidthSmall">0</sys:Double>
    <sys:Double x:Key="PaletteTop">38</sys:Double>
    <sys:Double x:Key="PaletteTopSmall">38</sys:Double>


    <!-- Page presentation (spec 06 section 6.5) -->
    <SolidColorBrush x:Key="GroupCardFill" Color="#EB12141B" />
    <SolidColorBrush x:Key="GroupCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="BackButtonFill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BackButtonStroke" Color="#00000000" />
    <sys:Double x:Key="BackButtonSize">34</sys:Double>
    <sys:Double x:Key="PageTop">6</sys:Double>
    <sys:Double x:Key="PageSideGutter">36</sys:Double>
    <sys:Double x:Key="PageSideGutterSmall">20</sys:Double>

    <sys:Double x:Key="FontSizeStat">34</sys:Double>
    <FontWeight x:Key="FontWeightStat">ExtraBold</FontWeight>

    <SolidColorBrush x:Key="PaletteFill" Color="#FF12141B" />
    <SolidColorBrush x:Key="PaletteStroke" Color="#FF2A2D3A" />
    <SolidColorBrush x:Key="PaletteLine" Color="#FF2A2D3A" />

    <SolidColorBrush x:Key="InputFill" Color="#FF07080B" />
    <SolidColorBrush x:Key="InputStroke" Color="#24FFFFFF" />

</ResourceDictionary>
