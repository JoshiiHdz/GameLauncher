<!-- ConsoleRibbon.Tokens.xaml — generated from 02-tokens.md. Same keys in all three themes. Swap this dictionary to switch theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:motion="clr-namespace:GameLauncher.Behaviors">

    <sys:String x:Key="ThemeId">ConsoleRibbon</sys:String>

    <!-- Colours -->
    <Color x:Key="BgColor">#FF0F1117</Color>
    <Color x:Key="Bg2Color">#FF1A1D27</Color>
    <Color x:Key="SurfaceColor">#FF22252F</Color>
    <Color x:Key="SurfaceTranslucentColor">#CC22252F</Color>
    <Color x:Key="Surface2Color">#1AFFFFFF</Color>
    <Color x:Key="StrokeColor">#1AFFFFFF</Color>
    <Color x:Key="ChipFillColor">#0FFFFFFF</Color>
    <Color x:Key="ChipFillHoverColor">#1AFFFFFF</Color>
    <Color x:Key="ChipStrokeColor">#29FFFFFF</Color>
    <Color x:Key="InkColor">#FFFFFFFF</Color>
    <Color x:Key="InkSoftColor">#FFE5E7EB</Color>
    <Color x:Key="MutedColor">#FF9CA3AF</Color>
    <Color x:Key="SubtleColor">#FF6B7280</Color>
    <Color x:Key="AccentColor">#FF2563EB</Color>
    <Color x:Key="AccentHoverColor">#FF1D4ED8</Color>
    <Color x:Key="AccentInkColor">#FFFFFFFF</Color>
    <Color x:Key="AccentTextColor">#FF60A5FA</Color>
    <Color x:Key="AccentGlowColor">#FF60A5FA</Color>
    <Color x:Key="AccentSoftFillColor">#2960A5FA</Color>
    <Color x:Key="AccentSoftStrokeColor">#8060A5FA</Color>
    <Color x:Key="FocusInkColor">#FFFFFFFF</Color>
    <Color x:Key="InverseFillColor">#1AFFFFFF</Color>
    <Color x:Key="InverseInkColor">#FFFFFFFF</Color>
    <Color x:Key="DangerColor">#FFF87171</Color>
    <Color x:Key="DangerSolidColor">#FFEF4444</Color>
    <Color x:Key="DangerFillColor">#29EF4444</Color>
    <Color x:Key="DangerStrokeColor">#80F87171</Color>
    <Color x:Key="StarColor">#FFFBBF24</Color>
    <Color x:Key="ArtPlateColor">#B80F1117</Color>
    <Color x:Key="ToggleOffTrackColor">#FF3A3D4A</Color>
    <Color x:Key="ToggleOffKnobColor">#FFFFFFFF</Color>
    <Color x:Key="CheckOffStrokeColor">#FF6B7280</Color>
    <Color x:Key="ScrimColor">#8C05060A</Color>
    <Color x:Key="ScrimLightColor">#6605060A</Color>

    <!-- Brushes (templates use only these) -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceTranslucent" Color="{StaticResource SurfaceTranslucentColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="ChipFill" Color="{StaticResource ChipFillColor}" />
    <SolidColorBrush x:Key="ChipFillHover" Color="{StaticResource ChipFillHoverColor}" />
    <SolidColorBrush x:Key="ChipStroke" Color="{StaticResource ChipStrokeColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentGlow" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="AccentSoftFill" Color="{StaticResource AccentSoftFillColor}" />
    <SolidColorBrush x:Key="AccentSoftStroke" Color="{StaticResource AccentSoftStrokeColor}" />
    <SolidColorBrush x:Key="FocusInk" Color="{StaticResource FocusInkColor}" />
    <SolidColorBrush x:Key="InverseFill" Color="{StaticResource InverseFillColor}" />
    <SolidColorBrush x:Key="InverseInk" Color="{StaticResource InverseInkColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSolid" Color="{StaticResource DangerSolidColor}" />
    <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}" />
    <SolidColorBrush x:Key="DangerStroke" Color="{StaticResource DangerStrokeColor}" />
    <SolidColorBrush x:Key="Star" Color="{StaticResource StarColor}" />
    <SolidColorBrush x:Key="ArtPlate" Color="{StaticResource ArtPlateColor}" />
    <SolidColorBrush x:Key="ToggleOffTrack" Color="{StaticResource ToggleOffTrackColor}" />
    <SolidColorBrush x:Key="ToggleOffKnob" Color="{StaticResource ToggleOffKnobColor}" />
    <SolidColorBrush x:Key="CheckOffStroke" Color="{StaticResource CheckOffStrokeColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrimLight" Color="{StaticResource ScrimLightColor}" />

    <!-- WPF-UI accent override: every library control reads the theme accent (01 §1.4) -->
    <Color x:Key="SystemAccentColor">#FF2563EB</Color>
    <Color x:Key="SystemAccentColorPrimary">#FF2563EB</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF2563EB</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF1D4ED8</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusRibbonItem">14</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">18</CornerRadius>
    <CornerRadius x:Key="RadiusHero">0</CornerRadius>
    <CornerRadius x:Key="RadiusButton">999</CornerRadius>
    <CornerRadius x:Key="RadiusInput">999</CornerRadius>
    <CornerRadius x:Key="RadiusMenu">20</CornerRadius>
    <CornerRadius x:Key="RadiusMenuRow">12</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">24</CornerRadius>
    <CornerRadius x:Key="RadiusPalette">22</CornerRadius>
    <CornerRadius x:Key="RadiusPalRow">14</CornerRadius>
    <CornerRadius x:Key="RadiusNavItem">999</CornerRadius>
    <CornerRadius x:Key="RadiusCheck">10</CornerRadius>
    <CornerRadius x:Key="RadiusPageLayer">22,22,0,0</CornerRadius>
    <CornerRadius x:Key="RadiusSheet">24,24,0,0</CornerRadius>

    <!-- Sizes, spacing, type sizes, depth (0 = not used by this theme) -->
    <sys:Double x:Key="CaptionHeight">32</sys:Double>
    <sys:Double x:Key="TopBarHeight">52</sys:Double>
    <sys:Double x:Key="FooterHeight">0</sys:Double>
    <sys:Double x:Key="SidebarWidth">0</sys:Double>
    <sys:Double x:Key="RailWidth">0</sys:Double>
    <sys:Double x:Key="PageGutter">48</sys:Double>
    <sys:Double x:Key="PageGutterSmall">24</sys:Double>
    <sys:Double x:Key="CardWidth">208</sys:Double>
    <sys:Double x:Key="CardHeight">270</sys:Double>
    <sys:Double x:Key="CardWidthSmall">136</sys:Double>
    <sys:Double x:Key="CardHeightSmall">177</sys:Double>
    <sys:Double x:Key="RibbonItemSize">144</sys:Double>
    <sys:Double x:Key="RibbonItemFocusedSize">216</sys:Double>
    <sys:Double x:Key="RibbonItemSizeSmall">70</sys:Double>
    <sys:Double x:Key="RibbonItemFocusedSizeSmall">108</sys:Double>
    <sys:Double x:Key="ShelfGap">14</sys:Double>
    <sys:Double x:Key="GridGapRow">22</sys:Double>
    <sys:Double x:Key="GridGapColumn">18</sys:Double>
    <sys:Double x:Key="ButtonHeight">40</sys:Double>
    <sys:Double x:Key="HeroButtonHeight">48</sys:Double>
    <sys:Double x:Key="InputHeight">40</sys:Double>
    <sys:Double x:Key="MenuWidth">300</sys:Double>
    <sys:Double x:Key="MenuRowHeight">40</sys:Double>
    <sys:Double x:Key="DialogWidth">440</sys:Double>
    <sys:Double x:Key="PaletteWidth">560</sys:Double>
    <sys:Double x:Key="PaletteWidthSmall">460</sys:Double>
    <sys:Double x:Key="PageBodyMaxWidth">700</sys:Double>
    <sys:Double x:Key="SettingsNavWidth">210</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">44</sys:Double>
    <sys:Double x:Key="FontSizeDisplaySmall">30</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">34</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeGroupTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeNote">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel">10</sys:Double>
    <sys:Double x:Key="FontSizeCardName">13</sys:Double>
    <sys:Double x:Key="FontSizeCardMeta">11</sys:Double>
    <sys:Double x:Key="FontSizeBadge">10</sys:Double>
    <sys:Double x:Key="FocusRingThickness">2</sys:Double>
    <sys:Double x:Key="FocusRingGap">0</sys:Double>
    <sys:Double x:Key="FocusScale">1.05</sys:Double>
    <sys:Double x:Key="HoverLift">0</sys:Double>
    <sys:Double x:Key="RiseDistance">14</sys:Double>
    <sys:Double x:Key="PageRiseDistance">48</sys:Double>
    <sys:Double x:Key="RecedeScale">0.965</sys:Double>
    <sys:Double x:Key="RecedeDimOpacity">0.55</sys:Double>
    <sys:Double x:Key="GlowBlurMin">16</sys:Double>
    <sys:Double x:Key="GlowBlurMax">30</sys:Double>

    <!-- Font weights -->
    <FontWeight x:Key="FontWeightDisplay">Light</FontWeight>
    <FontWeight x:Key="FontWeightPageTitle">Light</FontWeight>
    <FontWeight x:Key="FontWeightGroupTitle">Medium</FontWeight>
    <FontWeight x:Key="FontWeightCardName">Medium</FontWeight>
    <FontWeight x:Key="FontWeightLabel">SemiBold</FontWeight>
    <FontFamily x:Key="ThemeFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Durations -->
    <Duration x:Key="DurHover">0:0:00.250</Duration>
    <Duration x:Key="DurFocus">0:0:00.320</Duration>
    <Duration x:Key="DurMenu">0:0:00.320</Duration>
    <Duration x:Key="DurPanel">0:0:00.380</Duration>
    <Duration x:Key="DurDialog">0:0:00.340</Duration>
    <Duration x:Key="DurPage">0:0:00.440</Duration>
    <Duration x:Key="DurBackground">0:0:01.400</Duration>
    <Duration x:Key="DurToast">0:0:00.420</Duration>
    <Duration x:Key="ToastHold">0:0:02.600</Duration>
    <Duration x:Key="DurBar">0:0:00.520</Duration>
    <Duration x:Key="DurBreathe">0:0:02.400</Duration>

    <!-- Easings (BezierEase from xaml/Code/BezierEase.cs) -->
    <motion:BezierEase x:Key="EaseStandard" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
    <motion:BezierEase x:Key="EaseFocus" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
    <motion:BezierEase x:Key="EaseOutSnap" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
    <motion:BezierEase x:Key="EaseSoft" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />


    <!-- Additions used by Shared.Styles.xaml and the theme templates (not in 02-tokens.md; same keys in every theme) -->
    <SolidColorBrush x:Key="TrackFill" Color="#14FFFFFF" />
    <Thickness x:Key="FocusRingMargin">-2</Thickness>
    <Thickness x:Key="FocusRingBorder">2</Thickness>
    <CornerRadius x:Key="RadiusBar">999</CornerRadius>
    <DropShadowEffect x:Key="PrimaryGlowEffect" ShadowDepth="0" BlurRadius="22" Color="#2563EB" Opacity="0.70" />
    <DropShadowEffect x:Key="HeroGlowEffect" ShadowDepth="0" BlurRadius="28" Color="#2563EB" Opacity="0.70" />
    <DropShadowEffect x:Key="ToggleGlowEffect" ShadowDepth="0" BlurRadius="12" Color="#2563EB" Opacity="0.60" />
    <DropShadowEffect x:Key="BarGlowEffect" ShadowDepth="0" BlurRadius="12" Color="#60A5FA" Opacity="0.60" />


    <!-- Layout values with their 760x480 ("Small") counterparts; ThemeLayout publishes the right one as Active<Name>. -->
    <sys:Double x:Key="HeroHeight">0</sys:Double>
    <sys:Double x:Key="HeroHeightSmall">0</sys:Double>
    <sys:Double x:Key="ToolTileWidth">0</sys:Double>
    <sys:Double x:Key="ToolTileWidthSmall">0</sys:Double>
    <sys:Double x:Key="ToolTileHeight">0</sys:Double>
    <sys:Double x:Key="ToolTileHeightSmall">0</sys:Double>
    <sys:Double x:Key="GuideWidth">0</sys:Double>
    <sys:Double x:Key="GuideWidthSmall">0</sys:Double>
    <sys:Double x:Key="DialogWidthSmall">440</sys:Double>
    <sys:Double x:Key="SearchWidth">0</sys:Double>
    <sys:Double x:Key="SearchWidthSmall">0</sys:Double>
    <sys:Double x:Key="SettingsTileWidth">0</sys:Double>
    <sys:Double x:Key="SettingsTileWidthSmall">0</sys:Double>
    <sys:Double x:Key="SettingsTileHeight">0</sys:Double>
    <sys:Double x:Key="SettingsTileHeightSmall">0</sys:Double>
    <sys:Double x:Key="SettingsNavWidthSmall">170</sys:Double>
    <sys:Double x:Key="RibbonTop">96</sys:Double>
    <sys:Double x:Key="RibbonTopSmall">88</sys:Double>
    <sys:Double x:Key="HeroTop">392</sys:Double>
    <sys:Double x:Key="HeroTopSmall">272</sys:Double>
    <sys:Double x:Key="FilterColumnWidth">240</sys:Double>
    <sys:Double x:Key="FilterColumnWidthSmall">190</sys:Double>
    <sys:Double x:Key="PaletteTop">110</sys:Double>
    <sys:Double x:Key="PaletteTopSmall">60</sys:Double>


    <!-- Page presentation (spec 06 section 6.5) -->
    <SolidColorBrush x:Key="GroupCardFill" Color="#CC22252F" />
    <SolidColorBrush x:Key="GroupCardStroke" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="BackButtonFill" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="BackButtonStroke" Color="#29FFFFFF" />
    <sys:Double x:Key="BackButtonSize">40</sys:Double>
    <sys:Double x:Key="PageTop">20</sys:Double>
    <sys:Double x:Key="PageSideGutter">48</sys:Double>
    <sys:Double x:Key="PageSideGutterSmall">24</sys:Double>

    <sys:Double x:Key="FontSizeStat">36</sys:Double>
    <FontWeight x:Key="FontWeightStat">Light</FontWeight>

    <SolidColorBrush x:Key="PaletteFill" Color="#FF1A1D27" />
    <SolidColorBrush x:Key="PaletteStroke" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PaletteLine" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="InputFill" Color="#FF0F1117" />
    <SolidColorBrush x:Key="InputStroke" Color="#24FFFFFF" />

</ResourceDictionary>
