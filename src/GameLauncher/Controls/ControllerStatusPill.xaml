<UserControl x:Class="GameLauncher.Controls.ControllerStatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:GameLauncher.Services"
             Focusable="False" IsTabStop="False" VerticalAlignment="Center"
             ToolTip="{Binding ControllerPillTooltip}"
             AutomationProperties.Name="{Binding ControllerPillTooltip}">
    <!-- Always on screen in the shipped themes (Axis title bar, PlayStation top bar; the Xbox style does not ship): whether a controller is connected (and its battery). Its DataContext is the library view model.
         The dot is grey with no controller, green with one, amber when the battery is low. In a small window only the dot and the glyph stay. -->
    <Border x:Name="Pill" CornerRadius="12" Padding="9,4" Background="#26FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#6B7280" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ControllerConnected}" Value="True">
                                <Setter Property="Fill" Value="#3DDC84" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ControllerBatteryLow}" Value="True">
                                <Setter Property="Fill" Value="#F5A524" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <ui:SymbolIcon Symbol="Games24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
            <TextBlock x:Name="Label" Text="{Binding ControllerPillText}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSmall, Source={x:Static services:ThemeState.Instance}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
