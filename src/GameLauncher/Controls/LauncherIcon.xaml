<UserControl x:Class="GameLauncher.Controls.LauncherIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" IsHitTestVisible="False" Width="14" Height="14" VerticalAlignment="Center">
    <!-- The game's launcher logo: the icon read from the launcher itself; the bundled Xbox logo (an MSIX package icon can never be extracted, so an Xbox
         game has none); or a generic glyph when neither exists. Its DataContext is the game. Size it with Width and Height. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="14" Height="14">
            <Image Source="{Binding PlatformIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image Source="/Assets/XboxLogo.png" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Visibility>
                    <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForXboxLogo}">
                        <Binding Path="Source" />
                        <Binding Path="PlatformIcon" />
                    </MultiBinding>
                </Image.Visibility>
            </Image>
            <ui:SymbolIcon Symbol="{Binding Source, Converter={x:Static conv:GameSourceToFallbackSymbolConverter.Instance}}" FontSize="11" Foreground="#E6FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon.Visibility>
                    <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForFallbackSymbol}">
                        <Binding Path="Source" />
                        <Binding Path="PlatformIcon" />
                    </MultiBinding>
                </ui:SymbolIcon.Visibility>
            </ui:SymbolIcon>
        </Grid>
    </Viewbox>
</UserControl>
