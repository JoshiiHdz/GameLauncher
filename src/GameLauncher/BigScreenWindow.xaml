<Window x:Class="GameLauncher.BigScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:beh="clr-namespace:GameLauncher.Behaviors"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        Title="Axis Game Launcher - big screen"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A small round hint chip: the controller button that does something. -->
            <Style x:Key="HintChipStyle" TargetType="Border">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Background" Value="{StaticResource DesignSurface2}" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- The carousel tile: no default list chrome; the highlighted one grows and gets the accent outline. -->
            <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="14,26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Panel.ZIndex" Value="1" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.14" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.14" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- A plain Window (not the themed FluentWindow) leaves text black, so the light ink is set once for everything inside. -->
    <Grid Background="{StaticResource DesignBg}" TextElement.Foreground="{StaticResource DesignInk}" beh:Motion.FadeIn="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Shelf heading -->
        <Grid Grid.Row="0" Margin="64,44,64,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" beh:Motion.Replay="{Binding ShelfName}">
                <TextBlock Text="{Binding ShelfName}" FontSize="34" FontWeight="Bold" />
                <TextBlock Text="{Binding ShelfPositionText}" FontSize="16" Opacity="0.55" VerticalAlignment="Bottom" Margin="18,0,0,6" />
            </StackPanel>
            <TextBlock Text="Axis Game Launcher" FontSize="14" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Carousel -->
        <ListBox x:Name="Carousel" Grid.Row="1" Margin="40,0" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                 ItemsSource="{Binding Games}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource TileContainerStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 MouseDoubleClick="Carousel_DoubleClick" Focusable="False"
                 beh:Motion.Replay="{Binding ShelfName}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="230" Height="320" CornerRadius="14" Background="{StaticResource DesignBg2}" ClipToBounds="True"
                            BorderThickness="3" x:Name="Tile">
                        <Grid>
                            <ui:SymbolIcon Symbol="Games24" FontSize="44" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                            <Border Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border.Background>
                            </Border>
                            <Image Source="{Binding Icon}" Width="72" Height="72" Stretch="Uniform"
                                   Visibility="{Binding IsCoverArt, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="7,4" CornerRadius="6"
                                    Background="{StaticResource DesignArtChipFill}"
                                    Visibility="{Binding Favorite, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <ui:SymbolIcon Symbol="Star24" FontSize="16" Foreground="#FFC83D" />
                            </Border>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource DesignAccent}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The highlighted game -->
        <StackPanel Grid.Row="2" Margin="64,0,64,18" HorizontalAlignment="Center" beh:Motion.Replay="{Binding SelectedGame}">
            <TextBlock Text="{Binding SelectedGame.Name}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1200" />
            <TextBlock FontSize="18" Opacity="0.7" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Run Text="{Binding SelectedGame.Source, Converter={x:Static conv:GameSourceDisplayConverter.Instance}, Mode=OneWay}" />
                <Run Text="  -  " />
                <Run Text="{Binding SelectedGame.PlayTimeDisplay, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- What the buttons do -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,36">
            <Border Style="{StaticResource HintChipStyle}"><TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Play" VerticalAlignment="Center" Margin="0,0,28,0" Opacity="0.8" />
            <Border Style="{StaticResource HintChipStyle}"><TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Back" VerticalAlignment="Center" Margin="0,0,28,0" Opacity="0.8" />
            <Border Style="{StaticResource HintChipStyle}"><TextBlock Text="Y" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Favorite" VerticalAlignment="Center" Margin="0,0,28,0" Opacity="0.8" />
            <Border Style="{StaticResource HintChipStyle}"><TextBlock Text="LB" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <Border Style="{StaticResource HintChipStyle}"><TextBlock Text="RB" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Change row" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>
    </Grid>
</Window>
