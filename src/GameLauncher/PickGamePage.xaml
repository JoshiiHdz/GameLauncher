<UserControl x:Class="GameLauncher.PickGamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Centred in its area in every theme: the Grid is held to the page width and a stretched element that is capped sits in the middle. -->
    <Grid MaxWidth="{DynamicResource PageBodyMaxWidth}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,8,0,24" beh:Motion.FadeIn="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Same 2:3 cover tile as the hero: real art fills it, a fallback exe icon stays small. -->
            <Border Grid.Column="0" Width="150" Height="225" CornerRadius="10" Margin="0,0,24,0" VerticalAlignment="Top"
                    Background="{DynamicResource Bg2}" ClipToBounds="True"
                    beh:Motion.Replay="{Binding Game}">
                <Grid DataContext="{Binding Game}">
                    <ui:SymbolIcon Symbol="Games24" FontSize="28" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                    <Border Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"
                                        AlignmentX="Center" AlignmentY="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Icon}" Width="52" Height="52" Stretch="Uniform"
                           Visibility="{Binding IsCoverArt, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" beh:Motion.Replay="{Binding Game}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="15" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBlock Text="HOW ABOUT" FontSize="10" FontWeight="SemiBold" Opacity="0.7"
                               VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Game.Name}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="96" Margin="0,0,0,8" />
                <TextBlock FontSize="12.5" Opacity="0.78"
                           Text="{Binding Game.Source, Converter={x:Static conv:GameSourceDisplayConverter.Instance}}" />
                <TextBlock FontSize="12.5" Opacity="0.78" Margin="0,3,0,0"
                           Visibility="{Binding Game.HasPlayTime, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Run Text="{Binding Game.PlayTimeDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Game.LastPlayedDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Not played yet" FontSize="12.5" Opacity="0.78" Margin="0,3,0,0"
                           Visibility="{Binding Game.HasPlayTime, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding PoolText}" FontSize="11.5" Opacity="0.5" Margin="0,10,0,18" />

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                               Padding="20,9" FontWeight="SemiBold" Click="Play_Click" />
                    <ui:Button Content="Pick another" Icon="{ui:SymbolIcon ArrowShuffle24}" Margin="10,0,0,0" Padding="16,9"
                               Command="{Binding PickAnotherCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
