<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.16.0</Version>

    <!-- Distribution moved from a portable single-file exe to a Velopack-installed app (see
         UpdateService.cs and App.xaml.cs's Main). Velopack does its own bundling via "vpk pack" on
         top of a plain self-contained publish: "dotnet publish -c Release -r win-x64 -o publish"
         with the self contained flag passed on that command line, and no PublishSingleFile or
         IncludeAllContentForSelfExtract, per Velopack's documented publish shape
         (docs.velopack.io/getting-started/csharp). Packaging still bundles the whole .NET runtime,
         so end users still need nothing pre-installed; self-contained is set at publish time, not
         baked in here, since "vpk pack" expects a plain multi-file publish output, not a
         single-file one. -->
    <StartupObject>GameLauncher.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Baked-in default SteamGridDB key so a fresh install has cover art with no setup.
         The file is gitignored: the key ships inside the built exe, never in git history.
         Absent (e.g. a fresh clone) the app simply starts with no default key. -->
    <EmbeddedResource Include="default-api-key.txt" Condition="Exists('default-api-key.txt')" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml is normally auto-classified as ApplicationDefinition, which generates its own
         Main() that skips straight to InitializeComponent()+Run(). Velopack must run before any of
         that (VelopackApp.Build().Run() in App.xaml.cs's own explicit Main, set via StartupObject
         above) so it can intercept the special install/update/uninstall relaunches it uses - this
         reclassifies App.xaml as a plain Page so the SDK doesn't generate a competing Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets GameLauncher.Tests reach GameSessionWatcher's internal test-seam constructor/overload
         (fake TimeProvider, IProcessProvider, IExecutableNameDiscovery) without making them public
         API. -->
    <InternalsVisibleTo Include="GameLauncher.Tests" />
  </ItemGroup>

</Project>
