<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.16.0</Version>

    <!-- Portable single-exe distribution: self-contained (no .NET install required on the target
         PC) + single-file. Baked in here, not just passed on the publish command line, so every
         future `dotnet publish -c Release -r win-x64` reproduces the same working build regardless
         of who runs it or from where (including CI). -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- WPF/WinForms apps are documented by Microsoft as not being reliable single-file candidates
         by default: the single-file host's native-library-only extraction misses resources WPF's
         window/interop layer needs at startup, which crashed on the gaming PC with
         DllNotFoundException inside WindowsBase's SetWindowLongPtrWndProc - the very first native
         window-creation call WPF makes - despite building and running fine here. Forcing every
         bundled file to extract at startup, not just the native libraries the host guesses it
         needs, is Microsoft's documented fix for exactly this failure mode. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Baked-in default SteamGridDB key so a fresh install has cover art with no setup.
         The file is gitignored: the key ships inside the built exe, never in git history.
         Absent (e.g. a fresh clone) the app simply starts with no default key. -->
    <EmbeddedResource Include="default-api-key.txt" Condition="Exists('default-api-key.txt')" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets GameLauncher.Tests reach GameSessionWatcher's internal test-seam constructor/overload
         (fake TimeProvider, IProcessProvider, IExecutableNameDiscovery) without making them public
         API. -->
    <InternalsVisibleTo Include="GameLauncher.Tests" />
  </ItemGroup>

</Project>
