<ui:FluentWindow x:Class="GameLauncher.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="What's New" Height="480" Width="440" MinHeight="320" MinWidth="360"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="What's New" />

        <StackPanel Grid.Row="1" Margin="24,8,24,12">
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="28"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                           HorizontalAlignment="Left" Margin="0,0,0,8" />

            <TextBlock FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12">
                <Run Text="Updated to v" /><Run Text="{Binding WhatsNewVersion}" />
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                <TextBlock Text="{Binding WhatsNewNotes}" TextWrapping="Wrap" FontSize="13" Opacity="0.9" />
            </ScrollViewer>
        </StackPanel>

        <!-- Just closes the window - MainWindow acknowledges the marker (deleting it) right after
             ShowDialog() returns, regardless of how the window closed (this button, the title bar's
             own close button, Alt+F4, ...), so that's the one place responsible for it, not this
             button specifically. -->
        <ui:Button Grid.Row="2" Content="Got it" Appearance="Primary"
                   Click="GotItButton_Click"
                   HorizontalAlignment="Stretch" Margin="24,0,24,20" />
    </Grid>
</ui:FluentWindow>
