<UserControl x:Class="GameLauncher.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="SectionNoteStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MaxWidth="820" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="0,0,14,0" Margin="24,8,24,16" VerticalScrollBarVisibility="Auto" beh:Motion.FadeIn="True">
            <StackPanel>
                <!-- Memory -->
                <TextBlock Text="Memory" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Asks Windows to trim the memory other apps are holding but not using, so more is free for a game. It never closes anything, and leaves the app you are using and the running game alone."
                           Style="{StaticResource SectionNoteStyle}" />
                <ProgressBar Height="6" Minimum="0" Maximum="1" beh:Motion.AnimatedValue="{Binding MemoryUsedFraction, Mode=OneWay}"
                             Foreground="{StaticResource DesignAccent}" Background="{StaticResource DesignTrackFill}" />
                <TextBlock Text="{Binding MemoryText}" FontSize="12" Opacity="0.75" Margin="0,6,0,10" TextWrapping="Wrap" />
                <ui:Button Content="Free up memory" Appearance="Primary" Icon="{ui:SymbolIcon Flash24}"
                           Command="{Binding FreeUpMemoryCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding MemoryResultText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasMemoryResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                <Separator Margin="0,22" />

                <!-- Storage -->
                <TextBlock Text="Storage" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Clears leftovers that are safe to lose. Sizes are shown before anything is deleted, and you are asked first."
                           Style="{StaticResource SectionNoteStyle}" />
                <!-- One bar, like the memory one above: full when the clutter is found, draining as it is cleared, ending on what is left. -->
                <ProgressBar x:Name="StorageBar" Height="6" Minimum="0" Maximum="1" beh:Motion.AnimatedValue="{Binding StorageBarFraction, Mode=OneWay}"
                             Foreground="{StaticResource DesignAccent}" Background="{StaticResource DesignTrackFill}"
                             Visibility="{Binding HasStorageBar, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock x:Name="StorageLine" Text="{Binding StorageText}" FontSize="12" Opacity="0.75" Margin="0,6,0,12" TextWrapping="Wrap"
                           Visibility="{Binding HasStorageBar, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,150,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource DesignMuted}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:Button Content="Scan again" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ScanCommand}" />
                    <ui:Button Content="Clear selected" Appearance="Primary" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0"
                               Command="{Binding CleanCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding StorageResultText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasStorageResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                <Separator Margin="0,22" />

                <!-- Other tools -->
                <TextBlock Text="More tools" Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="BleachBit and Mem Reduct are free, open-source cleaners (GPLv3). They are not built into Axis - they open here if you have them."
                           Style="{StaticResource SectionNoteStyle}" />
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding OpenCommand}" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
