<UserControl x:Class="GameLauncher.CommandPaletteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:GameLauncher"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             Width="620"
             local:AppShell.Chromeless="True"
             local:AppShell.LightDismiss="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Its own card (no title bar or close button): the window puts it in the upper-middle of the dimmed layer. -->
    <Border CornerRadius="14" Background="{StaticResource DesignSurface}" TextElement.Foreground="{StaticResource DesignInk}"
            BorderBrush="{StaticResource DesignStroke}" BorderThickness="1"
            beh:Motion.FadeIn="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="QueryBox" Grid.Row="0" Margin="14,14,14,10" FontSize="16" Padding="12,10"
                        PlaceholderText="Search games and commands..."
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox x:Name="ResultList" Grid.Row="1" Margin="8,0,8,10" MaxHeight="370" BorderThickness="0" Background="Transparent"
                     ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,8" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_Click" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Width="30" FontSize="17" VerticalAlignment="Center" Opacity="0.75">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Flash24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Game">
                                                <Setter Property="Symbol" Value="Games24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource DesignMuted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Margin="22,0,22,16" FontSize="12.5" Opacity="0.6"
                       Visibility="{Binding HasNoResults, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

            <Border Grid.Row="2" BorderBrush="{StaticResource DesignStroke}" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock Text="Up/Down to move   Enter to choose   Esc to close" FontSize="11" Foreground="{StaticResource DesignMuted}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
