<UserControl x:Class="GameLauncher.OnScreenKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameLauncher.Controls"
             Focusable="False" IsTabStop="False" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Contained">
    <!-- The keyboard the pad types with. It rises from the bottom of the window over whatever has the text box, shows what is being typed (the text box may be under it), and holds
         the pad until Done or B. Its keys are ordinary buttons, so the pad moves over them like any other control; X, Y, the shoulders and the triggers are shortcuts (see
         KeyboardLayout.Help). -->
    <UserControl.Resources>
        <Style x:Key="KeyStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#52FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F2161921" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="22" Padding="20,16,20,14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Border Background="#40000000" CornerRadius="12" Padding="16,11" Margin="0,0,0,12" BorderBrush="#1AFFFFFF" BorderThickness="1">
                <TextBlock x:Name="Preview" FontSize="18" Foreground="White" TextTrimming="CharacterEllipsis" MaxHeight="28" />
            </Border>
            <StackPanel x:Name="KeyRows" />
            <controls:PadHintsStrip x:Name="HelpLine" Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
