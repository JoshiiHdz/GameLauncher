<ui:FluentWindow x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        xmlns:vm="clr-namespace:GameLauncher.ViewModels"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Game Launcher" Height="760" Width="1180" MinHeight="480" MinWidth="760"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:LibraryViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStarConverter x:Key="BoolToStarConverter" />

        <!-- Hover/selection states are plain property triggers - no Storyboards or timers, so the
             app costs effectively nothing while idle or while a game is running. -->
        <Style x:Key="GameCardStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <!-- Appearance=Transparent alone still leaves WPF-UI painting its own square-cornered
                 background/border behind the card, which showed as a pale hard-cornered frame. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Real cover art fills the tile edge-to-edge; a fallback exe icon stays small and centered
             so it isn't stretched into a blurry mess. -->
        <Style x:Key="GameArtImageStyle" TargetType="Image">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoverArt}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="NaN" />
                    <Setter Property="Stretch" Value="UniformToFill" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteStarStyle" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Foreground" Value="#FFC83D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One card definition shared by the Favorites section and the main library grid -->
        <DataTemplate x:Key="GameCardTemplate">
            <ui:Button Style="{StaticResource GameCardStyle}"
                       Margin="0,0,12,14" Width="124"
                       Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <Border x:Name="CardRoot" CornerRadius="8" Background="#33000000">
                    <!-- Explicit clip so the caption strip's bottom corners round too, not just the art -->
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,124,216" RadiusX="8" RadiusY="8" />
                    </Border.Clip>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="124" Height="186">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Games24" FontSize="34" Opacity="0.35"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding Icon}"
                                           Style="{StaticResource GameArtImageStyle}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

            <!-- Platform badge: the launcher's own icon, or a small muted glyph when the source
                 is unknown - kept subtle so it marks the cover rather than blotting it out. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="5,5,0,0" Padding="2" CornerRadius="4"
                                    Background="#8C000000" ToolTip="{Binding Source}">
                                <Grid Width="14" Height="14">
                                    <Image Source="{Binding PlatformIcon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ui:SymbolIcon Symbol="Question24" FontSize="10" Foreground="#8CFFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding PlatformIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                </Grid>
                            </Border>

                            <!-- Hover reveal: Visibility swap on a property trigger, no animation loop -->
                            <Border x:Name="HoverOverlay" Background="#A6000000" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="28" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="Play" FontWeight="SemiBold" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Background="#CC0A0A0A" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="7,0,2,0" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip="{Binding Name}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <ui:Button Grid.Column="1" Style="{StaticResource FavoriteStarStyle}"
                                       Margin="0,0,5,0"
                                       Content="{Binding Favorite, Converter={StaticResource BoolToStarConverter}}"
                                       ToolTip="Favorite"
                                       Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ui:Button>

            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Game Launcher" />

        <DockPanel Grid.Row="1" Margin="20,4,20,12">
            <!-- Header row: library title on the left, controls on the right. Kept out of the title
                 bar so the control cluster can't overflow the caption buttons on a narrow window. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:TextBox Width="200" PlaceholderText="Search games..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}" />

                    <ComboBox Margin="8,0,0,0" MinWidth="150"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SortOption}" />

                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="Re-scan library"
                               Command="{Binding RefreshCommand}" />

                    <ui:Button x:Name="SettingsButton" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="Settings"
                               Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Empty state: only when the library is genuinely empty, not when a search filters it out -->
            <Grid DockPanel.Dock="Top" Visibility="{Binding HasNoGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" MaxWidth="360">
                    <ui:SymbolIcon Symbol="Games24" FontSize="56" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="No games found yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Games are auto-detected from Steam, Epic and GOG, or add a folder to scan."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="Scan Now" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Add Folder" Icon="{ui:SymbolIcon FolderAdd24}" Appearance="Primary"
                                   Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoGames, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <!-- Favorites section - it and its divider disappear entirely when nothing is starred -->
                    <StackPanel Visibility="{Binding HasFavorites, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="Favorites" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12" />

                        <ItemsControl ItemsSource="{Binding FavoriteGames}"
                                      ItemTemplate="{StaticResource GameCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Separator Margin="0,4,0,20" Opacity="0.4" />
                    </StackPanel>

                    <TextBlock Text="{Binding LibraryHeaderText}" FontSize="17" FontWeight="SemiBold"
                               Margin="2,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Games}"
                                  ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <StatusBar Grid.Row="2" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="16,0" FontSize="12" Opacity="0.7" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
