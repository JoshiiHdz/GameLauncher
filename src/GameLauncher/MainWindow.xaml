<ui:FluentWindow x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        xmlns:beh="clr-namespace:GameLauncher.Behaviors"
        xmlns:controls="clr-namespace:GameLauncher.Controls"
        xmlns:services="clr-namespace:GameLauncher.Services"
        xmlns:vm="clr-namespace:GameLauncher.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Axis Game Launcher" Height="760" Width="1180" MinHeight="480" MinWidth="760"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ShowCommandPaletteCommand}" />
        <KeyBinding Key="F11" Command="{Binding EnterControllerModeFromAxisCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- GameCardStyle/GameArtImageStyle/FavoriteStarStyle/CardIconButtonStyle/GameCardTemplate
                     all live here now, not inline - see the file's own header comment for why (shared,
                     byte-for-byte, with the WPF test fixture that verifies the card's context-menu
                     wiring). -->
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
                <ResourceDictionary Source="Resources/GameCardTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- The pages that fill the content area (see LibraryViewModel.CurrentPage): the control for each is picked by the type of
             the page's view model. Settings has no view model of its own - it binds to the library itself. -->
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><local:SettingsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type services:LibraryStatsSnapshot}"><local:StatsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type services:SystemInfoSnapshot}"><local:MyPcPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><local:OptimizePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}"><local:StoragePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameDetailsViewModel}"><local:GameDetailsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PickGameViewModel}"><local:PickGamePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayTimeViewModel}"><local:PlayTimePage /></DataTemplate>

        <!-- Pill row for each source toggle - a soft hover highlight ties it to the same rounded,
             card-driven language as the game grid instead of a bare list of switches. -->
        <Style x:Key="SidebarRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>

        <Style x:Key="SidebarToggleStyle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows-style caption buttons, drawn by the app rather than by WPF-UI's TitleBar (which
             renders none in this build). Close gets the standard red hover; the other two the usual
             subtle wash. Sized 46x48 to match the system's own caption metrics. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource DesignCloseHover}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The hero's secondary "More" button: a soft filled pill rather than an outlined one, so the
             accent Play button beside it stays the obvious primary action. -->
        <Style x:Key="HeroGhostButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource ChipFill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChipFillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rail view buttons. RadioButton (not ToggleButton) so the three are mutually exclusive by
             construction; IsChecked is bound OneWay off the view model's own view state, and the click
             goes through SelectViewCommand, so the selection can never diverge from what the grid is
             actually showing. The accent bar on the left edge is the active marker. -->
        <Style x:Key="RailNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root" beh:ThemeRadius.Key="RadiusNavItem" Background="Transparent" Padding="0,0">
                                <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Border x:Name="Ring" beh:ThemeRadius.Key="RadiusNavItem" Margin="-4" BorderBrush="{DynamicResource FocusInk}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <!-- The open view or page: a soft fill and the accent on the icon and label - two cues, so it is never colour alone. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="13,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Plain round rail button (drives, Add folder, Rescan) - no checked state, same hover language. -->
        <Style x:Key="RailPlainButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" beh:ThemeRadius.Key="RadiusNavItem" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Border x:Name="Ring" beh:ThemeRadius.Key="RadiusNavItem" Margin="-4" BorderBrush="{DynamicResource FocusInk}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="13,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared visibility switches for the sidebar: text that only exists when it is expanded, and
             the icon-only counterparts that only exist when it is collapsed. Keyed off the window VM
             through the Window ancestor so they work inside data templates too. -->
        <Style x:Key="ExpandedOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CollapsedOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The count on the right of a view row. -->
        <Style x:Key="SidebarCountStyle" TargetType="TextBlock" BasedOn="{StaticResource ExpandedOnlyStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ExpandedOnlyStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RailSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ExpandedOnlyStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="14,10,10,4" />
        </Style>

        <!-- Accordion sections in the sidebar (Tools, Launchers, Drives): the title is a button with a chevron. Shown only while the
             sidebar is expanded - the icon rail has no titles, so it always shows every row. -->
        <Style x:Key="AccordionHeaderStyle" TargetType="Button" BasedOn="{StaticResource ExpandedOnlyStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="0,0,8,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rows under an accordion title. The Tag says "folded", and folded rows vanish - in the icon rail as well as in the wide
             sidebar, so a section folded in one stays folded in the other. -->
        <Style x:Key="AccordionBodyStyle" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- In the icon rail there is no title to click, so each foldable section shows one small chevron instead: it opens and folds the
             section's icons the same way the title does in the wide sidebar. -->
        <Style x:Key="RailAccordionToggleStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon rail buttons (the Sources filter toggle, today just the one) - round, bare-template
             for the same reason as every other bare button in this app: a plain ui:Button paints its
             own square hover chrome that would show through the round shape. -->
        <Style x:Key="RailIconButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#29FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Opaque, in the design's own base colour: the acrylic backdrop let the desktop through and
         washed every surface toward grey, which is why the app never matched the preview's palette. -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon" Visibility="Collapsed"
                        ToolTipText="Axis Game Launcher"
                        TrayMouseDoubleClick="TrayIcon_Restore">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Axis Game Launcher" Click="TrayIcon_Restore" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Native caption region: Windows owns dragging, restore-drag, snapping and double-click. -->
        <Border x:Name="WindowDragBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="44"
                Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                Background="{DynamicResource Surface}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Stroke}">
            <Grid>

            <!-- DockPanel, not a 3-column Grid: with star columns the right-hand cluster collapsed to a
                 few pixels and shoved the search box off centre. Docking is unambiguous - the edges
                 claim exactly what they need and the search takes the rest. -->
            <DockPanel x:Name="TitleBarDock" Margin="14,0,0,0" LastChildFill="True" Panel.ZIndex="10">
                <!-- Dock=Right children claim the right edge in declaration order. Only the caption buttons live here now: the tools are
                     in the sidebar, and rescan and the hidden-games toggle sit in the library's own header. -->
                <!-- Literal stroke colours rather than binding to the button's Foreground: that binding
                     resolved to null here, leaving the glyphs invisible while the buttons themselves
                     still laid out and took space - a silent failure that looked like "no buttons". -->
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButtonStyle}"
                        Click="CaptionClose_Click" ToolTip="Close" Tag="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#FFD5DAE6"
                          StrokeThickness="1.2" Width="10" Height="10" />
                </Button>
                <Button x:Name="CaptionMaximizeButton" DockPanel.Dock="Right" Click="CaptionMaximize_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="ToolTip" Value="Restore Down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path x:Name="CaptionMaximizeGlyph" Stroke="#E8FFFFFF" StrokeThickness="1.2"
                          Width="12" Height="12">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M1,1 L11,1 11,11 1,11 Z" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Data" Value="M3,3 L3,1 11,1 11,9 9,9 M1,3 L9,3 9,11 1,11 Z" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButtonStyle}"
                        Click="CaptionMinimize_Click" ToolTip="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="#E8FFFFFF"
                          StrokeThickness="1.2" Width="10" Height="1" />
                </Button>

                <!-- Whether a controller is connected, always visible; just left of the caption buttons. -->
                <controls:ControllerStatusPill x:Name="AxisControllerPill" DockPanel.Dock="Right" Margin="0,0,10,0" />

                <!-- Axis's way into controller mode (also F11, Ctrl+K, and Start on a pad): puts the PlayStation look on for the session. -->
                <Button x:Name="AxisControllerModeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButtonStyle}" Width="38"
                        Command="{Binding EnterControllerModeFromAxisCommand}" ToolTip="Controller mode (F11)"
                        AutomationProperties.Name="Controller mode" AutomationProperties.AutomationId="AxisControllerModeButton"
                        Visibility="{Binding IsAxisTheme, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="#E8FFFFFF" />
                </Button>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/AppIcon.png" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Axis Game Launcher" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <!-- Fills whatever is left between brand and buttons, centred within it. -->
                <ui:TextBox x:Name="SearchBox" Width="380" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            PlaceholderText="Search your library...  (Ctrl+K for commands)"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            FontSize="12.5"
                            Foreground="{DynamicResource Ink}"
                            Background="{DynamicResource Bg2}"
                            BorderThickness="1" BorderBrush="{DynamicResource Stroke}" />
            </DockPanel>
            </Grid>
        </Border>

        <!-- Left sidebar: expanded (labels, drive names, per-launcher switches - the old sidebar's
             layout) or collapsed to a 58px icon rail, toggled from its top button and remembered.
             Collapsed, each launcher is just its icon: full colour when its games are shown, a grey
             copy when switched off, so the rail itself says which are on. Width animates; the labels
             and rows that only exist when expanded are switched by ExpandedOnlyStyle/CollapsedOnlyStyle. -->
        <Border x:Name="SidebarPanel" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" ClipToBounds="True"
                Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                Background="{DynamicResource Bg}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Stroke}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="64" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                            <Setter Property="Width" Value="232" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="64" To="232" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="232" To="64" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True" Margin="9,12,9,10">
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="SidebarToggleButton" Style="{StaticResource RailPlainButtonStyle}" Margin="0,0,0,10"
                            ToolTip="Expand or collapse the sidebar" Command="{Binding ToggleSidebarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="18" Width="18" />
                            <TextBlock Text="Collapse" Style="{StaticResource RailLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Pinned to the bottom of the sidebar: Settings, with Shut down PC at the very bottom (declared first = lowest). -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource RailPlainButtonStyle}" Margin="0,0,0,0"
                        ToolTip="Shut down this PC (asks first)" Command="{Binding ShutdownPcCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Power24" FontSize="18" Width="18" />
                        <TextBlock Text="Shut down PC" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </Button>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource RailNavButtonStyle}" Margin="0,2,0,2" ToolTip="Settings"
                             IsChecked="{Binding IsSettingsPageOpen, Mode=OneWay}"
                             Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" Width="18" />
                        <TextBlock Text="Settings" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </RadioButton>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <!-- In the 58px icon rail a scrollbar would sit on the icons; the wheel still scrolls it. -->
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <!-- The views and Rescan scroll with everything else, so a short window (or a long library of launchers, collections and
                             drives) never pushes anything out of reach. Only Collapse (top) and Settings / Shut down (bottom) stay put. -->
                    <!-- LIBRARY: the views, with the rescan icon on the header. -->
                    <Border Style="{StaticResource ExpandedOnlyStyle}">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="LIBRARY" Style="{StaticResource RailSectionHeaderStyle}" Margin="14,4,10,4" />
                            <Button x:Name="RescanToolButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Width="22" Height="22" MinHeight="22" Padding="0"
                                    Style="{StaticResource RailPlainButtonStyle}" ToolTip="Rescan library" Command="{Binding RescanCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Width="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="All games"
                                 Command="{Binding SelectViewCommand}" CommandParameter="all">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static conv:ViewActiveConverter.Instance}" Mode="OneWay">
                                <Binding Path="IsAllViewSelected" />
                                <Binding Path="IsPageOpen" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" Width="18" />
                                <TextBlock Text="All games" Style="{StaticResource RailLabelStyle}" FontSize="14" Foreground="{DynamicResource Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AllGamesCount}" Style="{StaticResource SidebarCountStyle}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Favorites"
                                 Command="{Binding SelectViewCommand}" CommandParameter="favorites">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static conv:ViewActiveConverter.Instance}" Mode="OneWay">
                                <Binding Path="IsFavoritesViewSelected" />
                                <Binding Path="IsPageOpen" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" FontSize="18" Width="18" />
                                <TextBlock Text="Favorites" Style="{StaticResource RailLabelStyle}" FontSize="14" Foreground="{DynamicResource Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding FavoritesCount}" Style="{StaticResource SidebarCountStyle}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Recently played"
                                 Command="{Binding SelectViewCommand}" CommandParameter="recent">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static conv:ViewActiveConverter.Instance}" Mode="OneWay">
                                <Binding Path="IsRecentViewSelected" />
                                <Binding Path="IsPageOpen" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="18" Width="18" />
                                <TextBlock Text="Recently played" Style="{StaticResource RailLabelStyle}" FontSize="14" Foreground="{DynamicResource Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RecentCount}" Style="{StaticResource SidebarCountStyle}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="The same game installed through more than one launcher"
                                 Visibility="{Binding HasDuplicates, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                 Command="{Binding SelectViewCommand}" CommandParameter="duplicates">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static conv:ViewActiveConverter.Instance}" Mode="OneWay">
                                <Binding Path="IsDuplicatesViewSelected" />
                                <Binding Path="IsPageOpen" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="18" Width="18" />
                                <TextBlock Text="Installed twice" Style="{StaticResource RailLabelStyle}" FontSize="14" Foreground="{DynamicResource Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DuplicatesCount}" Style="{StaticResource SidebarCountStyle}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Games with no tracked play time yet"
                                 Command="{Binding SelectViewCommand}" CommandParameter="unplayed">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static conv:ViewActiveConverter.Instance}" Mode="OneWay">
                                <Binding Path="IsNeverPlayedViewSelected" />
                                <Binding Path="IsPageOpen" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Width="18" />
                                <TextBlock Text="Not played yet" Style="{StaticResource RailLabelStyle}" FontSize="14" Foreground="{DynamicResource Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UnplayedCount}" Style="{StaticResource SidebarCountStyle}" />
                        </Grid>
                    </RadioButton>
                    <!-- The Rescan action is the LIBRARY header's own button in the wide sidebar (the header turns into a divider in the icon rail, so the rail
                         keeps a plain icon for it). -->
                <Button x:Name="RescanRailButton" Style="{StaticResource RailPlainButtonStyle}" Margin="0,0,0,2" ToolTip="Scan your PC for games again" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                    <Button.Visibility>
                        <Binding Path="IsSidebarExpanded" Converter="{x:Static conv:InverseBoolToVisibilityConverter.Instance}" />
                    </Button.Visibility>
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Width="18" />
                </Button>
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="6,7,6,7"
                                Visibility="{Binding HasCollections, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <Border Style="{StaticResource ExpandedOnlyStyle}">
                            <TextBlock Text="COLLECTIONS" Style="{StaticResource RailSectionHeaderStyle}"
                                       Visibility="{Binding HasCollections, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </Border>

                        <!-- Collections: the user's own groups. Click filters the grid to one (click again to clear);
                             right-click deletes it. Collapsed, each is just its initial. -->
                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="CollectionButton" Style="{StaticResource RailPlainButtonStyle}"
                                            Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.SelectCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Name}"
                                            ToolTip="{Binding ToolTip}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete collection"
                                                          Command="{Binding PlacementTarget.Tag.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CollectionInitial" Grid.Column="0" Text="{Binding Initial}"
                                                       FontSize="13" FontWeight="SemiBold" Opacity="0.8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RailLabelStyle}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" Margin="6,0,8,0"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                       Style="{StaticResource ExpandedOnlyStyle}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="CollectionInitial" Property="Opacity" Value="1" />
                                            <Setter TargetName="CollectionInitial" Property="Foreground"
                                                    Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="6,7,6,7"
                                Visibility="{Binding HasAnySourceGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                        <!-- LAUNCHERS, expanded: the old sidebar's pill rows (badge, name, switch). A row
                             exists only once a scan has found games for that launcher. -->
                        <!-- The Button's own Visibility is bound, which beats the style: the wrapper is what keeps the title out of the icon rail. -->
                        <Border Style="{StaticResource ExpandedOnlyStyle}">
                            <Button x:Name="LaunchersHeader" Style="{StaticResource AccordionHeaderStyle}" Command="{Binding ToggleLaunchersCommand}"
                                    IsHitTestVisible="{Binding HasMultipleLaunchers}" ToolTip="Show or hide the launchers"
                                    Visibility="{Binding HasAnySourceGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Grid>
                                    <TextBlock Text="LAUNCHERS" Style="{StaticResource RailSectionHeaderStyle}" Margin="12,6,0,6" />
                                    <!-- A single launcher has nothing to fold: no chevron, and the title is plain text. -->
                                    <ui:SymbolIcon HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding HasMultipleLaunchers, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronDown20" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLaunchersExpanded}" Value="False">
                                                        <Setter Property="Symbol" Value="ChevronRight20" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Button>
                        </Border>
                        <!-- Icon rail: the same fold/unfold, as one small chevron (the wide sidebar uses the title above). -->
                        <Border Style="{StaticResource CollapsedOnlyStyle}">
                            <Button x:Name="LaunchersRailToggle" Style="{StaticResource RailAccordionToggleStyle}" Command="{Binding ToggleLaunchersCommand}"
                                    ToolTip="Show or hide the launchers"
                                Visibility="{Binding HasMultipleLaunchers, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <ui:SymbolIcon FontSize="12">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLaunchersExpanded}" Value="False">
                                                    <Setter Property="Symbol" Value="ChevronRight20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>
                        </Border>
                        <StackPanel x:Name="LaunchersBody" Style="{StaticResource AccordionBodyStyle}" Tag="{Binding LaunchersFolded}">
                        <ItemsControl x:Name="ExpandedLaunchers" ItemsSource="{Binding SourceItems}" Style="{StaticResource ExpandedOnlyStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Style="{StaticResource SidebarRowStyle}" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowLetter, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="15" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding UsesGlyph, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                                    <Image Source="{Binding DisplayIcon}" Width="16" Height="16"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                                             IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasGames}" Value="True">
                                            <Setter TargetName="Row" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- LAUNCHERS, collapsed: icon only. Pressed = shown (full colour); not pressed =
                             hidden (grey icon). Click flips it, same as the switch above. -->
                        <ItemsControl x:Name="CollapsedLaunchers" ItemsSource="{Binding SourceItems}" Style="{StaticResource CollapsedOnlyStyle}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton x:Name="IconButton" Style="{StaticResource RailIconButtonStyle}"
                                                  Width="40" Height="40" Margin="0,0,0,4" Visibility="Collapsed"
                                                  ToolTip="{Binding ToolTip}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                        <Grid>
                                            <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowLetter, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                            <ui:SymbolIcon Symbol="Games24" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding UsesGlyph, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                            <Image Source="{Binding DisplayIcon}" Width="20" Height="20"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </ToggleButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasGames}" Value="True">
                                            <Setter TargetName="IconButton" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="6,7,6,7"
                                Visibility="{Binding HasDrives, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <!-- The Button's own Visibility is bound, which beats the style: the wrapper is what keeps the title out of the icon rail. -->
                        <Border Style="{StaticResource ExpandedOnlyStyle}">
                            <Button x:Name="DrivesHeader" Style="{StaticResource AccordionHeaderStyle}" Command="{Binding ToggleDrivesCommand}"
                                    IsHitTestVisible="{Binding HasMultipleDrives}" ToolTip="Show or hide the drives"
                                    Visibility="{Binding HasDrives, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Grid>
                                    <TextBlock Text="DRIVES" Style="{StaticResource RailSectionHeaderStyle}" Margin="12,6,0,6" />
                                    <ui:SymbolIcon HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding HasMultipleDrives, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronDown20" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDrivesExpanded}" Value="False">
                                                        <Setter Property="Symbol" Value="ChevronRight20" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Icon rail: the same fold/unfold, as one small chevron (the wide sidebar uses the title above). -->
                        <Border Style="{StaticResource CollapsedOnlyStyle}">
                            <Button x:Name="DrivesRailToggle" Style="{StaticResource RailAccordionToggleStyle}" Command="{Binding ToggleDrivesCommand}"
                                    ToolTip="Show or hide the drives"
                                Visibility="{Binding HasMultipleDrives, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <ui:SymbolIcon FontSize="12">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrivesExpanded}" Value="False">
                                                    <Setter Property="Symbol" Value="ChevronRight20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>
                        </Border>
                        <!-- Drives: only the ones games actually live on, re-checked after every scan -->
                        <StackPanel x:Name="DrivesBody" Style="{StaticResource AccordionBodyStyle}" Tag="{Binding DrivesFolded}">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <Button x:Name="DriveButton" Style="{StaticResource RailPlainButtonStyle}"
                                            Height="Auto" MinHeight="40" Margin="0,0,0,6"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Letter}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{Binding SummaryText}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="What's using this drive?"
                                                          Command="{Binding PlacementTarget.Tag.ShowStorageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.Letter, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="DataPie24" FontSize="15" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <!-- Switch the drive off (nothing on it is searched, its games leave the library) or back on. -->
                                                <MenuItem x:Name="DriveIgnoreMenuItem"
                                                          Command="{Binding PlacementTarget.Tag.ToggleDriveIgnoredCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.Letter, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Prohibited24" FontSize="15" />
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="Don't search this drive" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsIgnored, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                    <Setter Property="Header" Value="Search this drive again" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel>
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="36">
                                                <!-- Track ring, then the used-space arc over it: a real arc, so a
                                                     73%-full drive reads as 73% at a glance the way the design's
                                                     ring does. See UsedFractionToArcConverter for the geometry. -->
                                                <Ellipse Width="32" Height="32" Stroke="{DynamicResource TrackFill}" StrokeThickness="2.5" />
                                                <Path x:Name="DriveArc" Stroke="{DynamicResource Accent}"
                                                      StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="{Binding UsedFraction, Converter={x:Static conv:UsedFractionToArcConverter.Instance}}" />
                                                <TextBlock x:Name="DriveLetter" Text="{Binding Letter, Converter={x:Static conv:DriveLetterGlyphConverter.Instance}}"
                                                           FontSize="11" FontWeight="SemiBold" Opacity="0.8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Style="{StaticResource RailLabelStyle}" Padding="0,0,26,0">
                                                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Letter, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                          </Grid>
                                          <StackPanel x:Name="DriveSpaceDetails" Style="{StaticResource ExpandedOnlyStyle}" Margin="8,4,8,8">
                                              <ProgressBar x:Name="DriveUsageBar" Height="5" Minimum="0" Maximum="1"
                                                           beh:Motion.AnimatedValue="{Binding UsedFraction, Mode=OneWay}" IsIndeterminate="False"
                                                           Foreground="{DynamicResource Accent}" Background="{DynamicResource TrackFill}"
                                                           IsHitTestVisible="False" />
                                              <TextBlock x:Name="DriveSpaceSummary" Text="{Binding SummaryText}" TextWrapping="Wrap"
                                                         FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                                              <TextBlock x:Name="DriveIgnoredNote" Text="Not searched - its games are hidden" TextWrapping="Wrap"
                                                         FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,3,0,0">
                                                  <TextBlock.Style>
                                                      <Style TargetType="TextBlock">
                                                          <Setter Property="Visibility" Value="Collapsed" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </TextBlock.Style>
                                              </TextBlock>
                                              <TextBlock x:Name="DriveWarning" Text="{Binding WarningText}" TextWrapping="Wrap"
                                                         FontSize="10" FontWeight="SemiBold" Foreground="#F5A524" Margin="0,3,0,0"
                                                         Visibility="{Binding HasWarning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                          </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <!-- The 3-dot menu: the same menu as a right-click, for people who do not know to right-click. Wide sidebar only. -->
                                    <Border Style="{StaticResource ExpandedOnlyStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0">
                                        <Button x:Name="DriveMenuButton" Style="{StaticResource RailPlainButtonStyle}"
                                                Width="24" Height="24" MinHeight="24" Padding="0" ToolTip="Drive options"
                                                Tag="{Binding ElementName=DriveButton}" Click="DriveMenu_Click">
                                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="15" />
                                        </Button>
                                    </Border>
                                  </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                            <Setter TargetName="DriveButton" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="DriveLetter" Property="Opacity" Value="1" />
                                            <Setter TargetName="DriveLetter" Property="Foreground"
                                                    Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                        <!-- Low on space: the ring, the bar and the warning line turn amber, or red when almost full. -->
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="DriveArc" Property="Stroke" Value="#F5A524" />
                                            <Setter TargetName="DriveUsageBar" Property="Foreground" Value="#F5A524" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                            <Setter TargetName="DriveArc" Property="Stroke" Value="#E5484D" />
                                            <Setter TargetName="DriveUsageBar" Property="Foreground" Value="#E5484D" />
                                            <Setter TargetName="DriveWarning" Property="Foreground" Value="#E5484D" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <!-- TOOLS: an accordion. Stats, Pick a game and Optimize are pages (the entry stays marked while its page is open);
                             Rescan library and Add folder act at once. -->
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="6,7,6,7" />
                        <Button x:Name="ToolsHeader" Style="{StaticResource AccordionHeaderStyle}" Command="{Binding ToggleToolsCommand}"
                                ToolTip="Show or hide the tools">
                            <Grid>
                                <TextBlock Text="TOOLS" Style="{StaticResource RailSectionHeaderStyle}" Margin="12,6,0,6" />
                                <ui:SymbolIcon HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToolsExpanded}" Value="False">
                                                    <Setter Property="Symbol" Value="ChevronRight20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Button>
                        <!-- Icon rail: the same fold/unfold, as one small chevron (the wide sidebar uses the title above). -->
                        <Border Style="{StaticResource CollapsedOnlyStyle}">
                            <Button x:Name="ToolsRailToggle" Style="{StaticResource RailAccordionToggleStyle}" Command="{Binding ToggleToolsCommand}"
                                    ToolTip="Show or hide the tools">
                                <ui:SymbolIcon FontSize="12">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToolsExpanded}" Value="False">
                                                    <Setter Property="Symbol" Value="ChevronRight20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>
                        </Border>
                        <StackPanel x:Name="ToolsBody" Style="{StaticResource AccordionBodyStyle}" Tag="{Binding ToolsFolded}">
                        <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Stats - play time and library figures"
                                     IsChecked="{Binding IsStatsPageOpen, Mode=OneWay}" Command="{Binding ShowStatsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18" Width="18" />
                                <TextBlock Text="Stats" Style="{StaticResource RailLabelStyle}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="My PC - specs, motherboard, BIOS and Secure Boot"
                                     IsChecked="{Binding IsMyPcPageOpen, Mode=OneWay}" Command="{Binding ShowMyPcCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Width="18" />
                                <TextBlock Text="My PC" Style="{StaticResource RailLabelStyle}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Pick a game for me"
                                     IsChecked="{Binding IsPickPageOpen, Mode=OneWay}" Command="{Binding PickGameCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="18" Width="18" />
                                <TextBlock Text="Pick a game" Style="{StaticResource RailLabelStyle}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailNavButtonStyle}" ToolTip="Optimize - free up memory and clear storage"
                                     IsChecked="{Binding IsOptimizePageOpen, Mode=OneWay}" Command="{Binding ShowOptimizeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="18" Width="18" />
                                <TextBlock Text="Optimize" Style="{StaticResource RailLabelStyle}" />
                            </StackPanel>
                        </RadioButton>
                        <Button x:Name="AddFolderButton" Style="{StaticResource RailPlainButtonStyle}" Margin="0,0,0,6"
                                ToolTip="Add a folder to watch" Command="{Binding AddFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="18" Width="18" />
                                <TextBlock Text="Add folder" Style="{StaticResource RailLabelStyle}" />
                            </StackPanel>
                        </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="AxisContent" Grid.Row="1" Grid.Column="1" Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{DynamicResource Bg2Color}" />
                    <GradientStop Offset="0.42" Color="{DynamicResource BgColor}" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- The design's radial accent glow behind the hero, bled in from the top. -->
            <Border VerticalAlignment="Top" Height="440" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.62,0" Center="0.62,0" RadiusX="0.62" RadiusY="1.0">
                        <GradientStop Offset="0" Color="#42FF6B86" />
                        <GradientStop Offset="0.7" Color="#00FF6B86" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

        <DockPanel Margin="26,22,26,26">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <!-- A page covers the library; hiding it (not just covering it) keeps Tab and the controller out of the cards beneath. -->
                        <DataTrigger Binding="{Binding IsPageOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <!-- Scan progress: a real bar (the launcher pass, then games identified so far) and what it is doing now. Only while scanning. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"
                        Visibility="{Binding IsLoading, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <ProgressBar Height="6" Minimum="0" Maximum="100"
                             Value="{Binding ScanProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsScanIndeterminate}" />
                <TextBlock Text="{Binding ScanProgressText}" FontSize="12" Opacity="0.75" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Update banner: sits above everything else (empty state included) so it's never missed,
                 but is a plain dismissible strip rather than a modal - checking/applying an update is
                 never allowed to block using the library in the meantime. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
                    Background="#1FFFFFFF"
                    Visibility="{Binding UpdateAvailable, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13">
                        <Run Text="Update available: v" /><Run Text="{Binding AvailableUpdateVersion}" />
                    </TextBlock>

                    <ui:Button Grid.Column="2" Appearance="Primary" Margin="0,0,8,0"
                               Content="{Binding IsUpdating, Converter={x:Static conv:UpdatingButtonTextConverter.Instance}}"
                               Command="{Binding DownloadUpdateCommand}" />

                    <ui:Button Grid.Column="3" Appearance="Transparent" BorderThickness="0"
                               Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss"
                               Command="{Binding DismissUpdateCommand}"
                               IsEnabled="{Binding IsUpdating, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                </Grid>
            </Border>

            <!-- Empty views explain their own purpose; only an empty library offers discovery actions. -->
            <Grid x:Name="LibraryEmptyState" DockPanel.Dock="Top" Visibility="{Binding HasNoGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" MaxWidth="360">
                    <ui:SymbolIcon x:Name="EmptyStateIcon" FontSize="56" HorizontalAlignment="Center" Opacity="0.5">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Games24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesViewSelected}" Value="True">
                                        <Setter Property="Symbol" Value="Star24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRecentViewSelected}" Value="True">
                                        <Setter Property="Symbol" Value="Clock24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNeverPlayedViewSelected}" Value="True">
                                        <Setter Property="Symbol" Value="Sparkle24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDuplicatesViewSelected}" Value="True">
                                        <Setter Property="Symbol" Value="Copy24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock x:Name="EmptyStateHeading" Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding EmptyStateDescription}"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <StackPanel x:Name="EmptyDiscoveryActions" Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyDiscoveryActions, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <ui:Button Content="Rescan library" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RescanCommand}" Margin="0,0,8,0"
                                   IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                        <ui:Button Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}" Appearance="Primary"
                                   Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The scrollbar is an OVERLAY in this theme - it paints on top of the content rather than
                 taking layout space of its own, so without a gutter it sat across the hero's right edge
                 and the last column of cards. The padding is that gutter. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0"
                          Visibility="{Binding HasNoGames, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                <StackPanel>
                <!-- "Jump back in" hero: the one visible game with the newest DateAdded, shown only on the
                     true unfiltered home view (LibraryViewModel.FeaturedGame hides it under search/a drive
                     filter - see its own remarks on why "recently added" rather than "most played": this
                     app has no way to know a game's playtime before it was added here, so that's the one
                     honest "which game matters right now" signal available). The background tint is a
                     colour sampled from the game's own cover art (DominantColorExtractor) - real box art,
                     not a per-game placeholder, is what makes that worth doing here. -->
                <Border x:Name="HeroCard" Margin="0,0,0,26" Height="{DynamicResource ActiveHeroHeight}" beh:ThemeRadius.Key="RadiusHero" beh:ThemeRadius.RoundClip="True"
                        beh:Motion.FadeIn="True" beh:Motion.Replay="{Binding FeaturedGame}"
                        Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Stroke}"
                        Visibility="{Binding HasFeaturedGame, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Grid>
                        <!-- The game's cover across the card, under a left-to-right wash that keeps the text on a dark base. -->
                        <Border DataContext="{Binding FeaturedGame}" Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FF0B0D13" Offset="0" />
                                    <GradientStop Color="#FF0B0D13" Offset="0.28" />
                                    <GradientStop Color="#C70B0D13" Offset="0.58" />
                                    <GradientStop Color="#590B0D13" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="28,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The cover: 150 x 195, hidden in a small window. -->
                            <Border Grid.Column="0" Width="150" Height="195" beh:ThemeRadius.Key="RadiusCard" beh:ThemeRadius.RoundClip="True" Margin="0,0,26,0"
                                    Background="{DynamicResource Bg2}" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="20" Direction="270" Opacity="0.7" Color="Black" />
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSmall, Source={x:Static services:ThemeState.Instance}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <ui:SymbolIcon Symbol="Games24" FontSize="26" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding FeaturedGame.Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <!-- DataContext retargeted to the GameEntry itself so GameArtImageStyle's IsCoverArt trigger resolves here too. -->
                                    <Border x:Name="HeroCoverFill" DataContext="{Binding FeaturedGame}"
                                            Visibility="{Binding IsCoverArt, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border.Background>
                                    </Border>
                                    <Image DataContext="{Binding FeaturedGame}" Source="{Binding Icon}" Style="{StaticResource GameArtImageStyle}"
                                           Visibility="{Binding IsCoverArt, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="JUMP BACK IN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding FeaturedGame.Name}" FontSize="{DynamicResource ActiveFontSizeDisplay}" FontWeight="Bold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

                                <!-- Meta line: the launcher pill (a real launcher icon and its name), drive and size, tracked time and when. Each piece hides on its own
                                     when there is nothing real behind it, so a never-played game shows the launcher and drive without an empty "0 h" next to them. -->
                                <WrapPanel Margin="0,0,0,16">
                                    <Border Height="24" Padding="4,0,10,0" beh:ThemeRadius.Key="Pill" Background="{DynamicResource ArtPlate}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="HeroPlatformBadge" DataContext="{Binding FeaturedGame}" Width="16" Height="16" VerticalAlignment="Center">
                                                <Image x:Name="HeroPlatformIcon" Source="{Binding PlatformIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Image x:Name="HeroXboxLogo" Source="pack://application:,,,/GameLauncher;component/Assets/XboxLogo.png" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Visibility>
                                                        <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForXboxLogo}">
                                                            <Binding Path="Source" />
                                                            <Binding Path="PlatformIcon" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <ui:SymbolIcon x:Name="HeroPlatformFallback" Symbol="{Binding Source, Converter={x:Static conv:GameSourceToFallbackSymbolConverter.Instance}}" FontSize="13" Opacity="0.75">
                                                    <ui:SymbolIcon.Visibility>
                                                        <MultiBinding Converter="{x:Static conv:PlatformBadgeVisibilityConverter.ForFallbackSymbol}">
                                                            <Binding Path="Source" />
                                                            <Binding Path="PlatformIcon" />
                                                        </MultiBinding>
                                                    </ui:SymbolIcon.Visibility>
                                                </ui:SymbolIcon>
                                            </Grid>
                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Text="{Binding FeaturedGame.Source, Converter={x:Static conv:LauncherNameConverter.Instance}}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <!-- A drawn hard-drive icon (body, divider, activity light, vent line), so it looks the same on every PC. -->
                                        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource InkSoft}" StrokeThickness="1.3" Opacity="0.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M3,2 H13 A2,2 0 0 1 15,4 V12 A2,2 0 0 1 13,14 H3 A2,2 0 0 1 1,12 V4 A2,2 0 0 1 3,2 Z M1,9 H15 M4.3,11.5 H4.4 M8,11.5 H12" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" Margin="7,0,0,0"
                                                   Text="{Binding FeaturedGame.InstallDir, Converter={x:Static conv:InstallDirToDriveConverter.Instance}}" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   Visibility="{Binding FeaturedGame.HasInstallSize, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                            <Run Text="·" /><Run Text=" " /><Run Text="{Binding FeaturedGame.InstallSizeDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding FeaturedGame.HasPlayTime, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{DynamicResource InkSoft}" Opacity="0.8" VerticalAlignment="Center" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" Margin="7,0,0,0">
                                            <Run Text="{Binding FeaturedGame.PlayTimeDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FeaturedGame.LastPlayedDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Height="{DynamicResource HeroButtonHeight}" Padding="18,0,22,0" FontSize="14" FontWeight="SemiBold"
                                               Command="{Binding LaunchCommand}" CommandParameter="{Binding FeaturedGame}" />
                                    <Button Margin="8,0,0,0" Height="{DynamicResource HeroButtonHeight}" Style="{StaticResource HeroGhostButtonStyle}"
                                            Tag="{Binding}" beh:ContextMenuButtonBehavior.OpensContextMenuOnClick="True">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="More" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Play"
                                                          Command="{Binding PlacementTarget.Tag.LaunchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag.FeaturedGame, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Game details..."
                                                          Command="{Binding PlacementTarget.Tag.ShowGameDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag.FeaturedGame, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Open install location"
                                                          Command="{Binding PlacementTarget.Tag.OpenInstallLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag.FeaturedGame, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Uninstall..." Foreground="{DynamicResource Danger}"
                                                          Command="{Binding PlacementTarget.Tag.UninstallGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag.FeaturedGame, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                    <!-- Recently played: a horizontal strip of what has actually been launched from
                         here, newest first. Hidden entirely until something has been played, rather
                         than showing an empty rail that implies missing data. -->
                    <StackPanel Margin="0,0,0,26"
                                Visibility="{Binding HasRecentlyPlayed, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" Margin="2,0,2,12">
                            <TextBlock Text="Recently played" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="Tracked by Axis Game Launcher" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <!-- A nested ScrollViewer marks the wheel handled even when it cannot scroll in
                             that direction, so hovering this row froze the page. The handler passes the
                             wheel up to the page instead. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="HorizontalStrip_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding RecentlyPlayedGames}" Tag="True"
                                          ItemTemplate="{StaticResource GameCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Grid heading: the view (or drive) name, its count, then Sort and Rescan right beside it - not parked at the far edge. -->
                    <WrapPanel Margin="2,0,2,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding LibraryHeaderText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LibrarySubheaderText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <ui:Button Margin="0,0,6,0" Padding="8,3" Appearance="Transparent" BorderThickness="0" FontSize="11" Content="Clear drive filter" VerticalAlignment="Center"
                                   Command="{Binding SelectDriveCommand}"
                                   Visibility="{Binding HasSelectedDriveFilter, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <ui:Button Margin="0,0,6,0" Padding="8,3" Appearance="Transparent" BorderThickness="0" FontSize="11" Content="What's using this drive?" VerticalAlignment="Center"
                                   Command="{Binding ShowStorageCommand}"
                                   Visibility="{Binding HasSelectedDriveFilter, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <ComboBox VerticalAlignment="Center" MinWidth="130" Height="28" MinHeight="28" Margin="0,0,6,0"
                                  FontSize="12" FontWeight="Medium" Padding="10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
                                  BorderThickness="1" BorderBrush="{DynamicResource Stroke}"
                                  ItemsSource="{Binding SortOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SortOption}" />
                        <ui:Button x:Name="RescanButton" Height="28" MinHeight="28" Padding="10,0" FontSize="12" FontWeight="Medium" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Content="Rescan library" ToolTip="Rescan library" Command="{Binding RescanCommand}"
                                   IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                        <!-- Only shows up once something is actually hidden - nothing to reveal otherwise. Without it there is no way back for anything the user hides. -->
                        <ui:Button x:Name="HiddenToggleButton" Appearance="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="Show/hide the Hidden Games section"
                                   Command="{Binding ToggleShowHiddenCommand}"
                                   Visibility="{Binding HasHiddenGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <Grid Width="18" Height="18">
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="16" Visibility="{Binding ShowHiddenGames, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                                <ui:SymbolIcon Symbol="Eye24" FontSize="16" Visibility="{Binding ShowHiddenGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            </Grid>
                        </ui:Button>
                    </WrapPanel>

                    <!-- The whole grid fades in when the view, drive or collection changes (the heading is what changes then) - not on every
                         keystroke of a search, where it would flicker. -->
                    <ItemsControl ItemsSource="{Binding Games}" Tag="{Binding IsRecentViewSelected}"
                                  ItemTemplate="{StaticResource GameCardTemplate}"
                                  beh:Motion.FadeIn="True" beh:Motion.Replay="{Binding LibraryHeaderText}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Hidden section - only when the user has both hidden something AND asked to see
                         the section via the header toggle; reuses the same card template and the same
                         ToggleHiddenCommand button on each card (now labeled "Unhide") to bring one back. -->
                    <StackPanel Visibility="{Binding ShowHiddenSection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                Margin="0,24,0,0">
                        <Separator Margin="0,0,0,20" Opacity="0.4" />
                        <TextBlock Text="Hidden" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12" Opacity="0.7" />

                        <ItemsControl ItemsSource="{Binding HiddenGames}"
                                      ItemTemplate="{StaticResource GameCardTemplate}"
                                      Opacity="0.65">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>


        </Grid>

        <!-- Console themes: a full-window shell in place of the sidebar app. Each is shown by the chosen theme and gets the ShellState as its
             DataContext (see MainWindow.Appearance.cs). The page host, the dialog layer and the caption sit above them. -->
        <Grid x:Name="ConsoleHost" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <local:ConsoleTileView x:Name="TileView" Visibility="{Binding DataContext.IsConsoleTileTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            <local:ConsoleRibbonView x:Name="RibbonView" Visibility="{Binding DataContext.IsConsoleRibbonTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
        </Grid>

        <!-- The caption the console themes share: a drag area with the title on the left and the window buttons on the right. -->
        <Grid x:Name="ConsoleCaption" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top" Panel.ZIndex="80"
              Background="Transparent" Visibility="{Binding ShowConsoleCaption, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="Axis Game Launcher" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButtonStyle}" Height="32" Width="46" Click="CaptionMinimize_Click" ToolTip="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="#C9CED8" StrokeThickness="1.2" Width="10" Height="1" />
                </Button>
                <Button x:Name="ConsoleMaximizeButton" Style="{StaticResource CaptionButtonStyle}" Height="32" Width="46" Click="CaptionMaximize_Click" ToolTip="Maximize">
                    <Path Stroke="#C9CED8" StrokeThickness="1.2" Width="12" Height="12">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M1,1 L11,1 11,11 1,11 Z" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Data" Value="M3,3 L3,1 11,1 11,9 9,9 M1,3 L9,3 9,11 1,11 Z" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Height="32" Width="46" Click="CaptionClose_Click" ToolTip="Close" Tag="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#C9CED8" StrokeThickness="1.2" Width="10" Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The open page (Settings, Stats, ...): a Back arrow and the page's title, then the page itself. Sits where the library sits,
             so the sidebar and the title bar stay put and the page is in the same theme as everything else. -->
        <Grid x:Name="PageHost" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Contained" Grid.Row="1" Grid.Column="1" Panel.ZIndex="10" Background="{DynamicResource Bg}"
              Visibility="{Binding IsPageOpen, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The page header: a back button, the title and an Esc hint, drawn from the theme's tokens (size, fill, radius, type). -->
            <Grid Grid.Row="0" Margin="{DynamicResource ActivePageHeaderMargin}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PageBackButton" Width="{DynamicResource BackButtonSize}" Height="{DynamicResource BackButtonSize}" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="{Binding BackTooltip, Source={x:Static services:ThemeState.Instance}}" FocusVisualStyle="{x:Null}" Command="{Binding ClosePageCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Glow" beh:ThemeRadius.Key="RadiusNavItem" Background="{DynamicResource Bg}" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource ToggleGlowEffect}" />
                                    <Border x:Name="Body" beh:ThemeRadius.Key="RadiusNavItem" Background="{DynamicResource BackButtonFill}" BorderBrush="{DynamicResource BackButtonStroke}" BorderThickness="1">
                                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Ring" beh:ThemeRadius.Key="RadiusNavItem" BorderBrush="{DynamicResource FocusInk}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                        <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                        <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="PageTitleText" Text="{Binding CurrentPageTitle}" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="{DynamicResource FontWeightPageTitle}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- Game details names itself: Console-tile with an eyebrow over the game's title, Console-ribbon with the title alone. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConsole, Source={x:Static services:ThemeState.Instance}}" Value="True" />
                                            <Condition Binding="{Binding CurrentPageKey}" Value="details" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Margin="12,0,0,0" Padding="5,2" CornerRadius="4" Background="{DynamicResource ChipFill}" VerticalAlignment="Center"
                            Visibility="{Binding ShortcutsEnabled, Source={x:Static services:ThemeState.Instance}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                    </Border>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageContent" Grid.Row="1" Content="{Binding CurrentPage}" Margin="{DynamicResource ActivePageBodyMargin}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"
                            beh:Motion.Replay="{Binding CurrentPageKey}" />
        </Grid>
        <!-- Footer: how much of the library is on screen (left) and whatever the app last did (right).
             The count is the honest signal that a view, drive, search or disabled source is narrowing
             things - "2 of 47 games shown" explains an unexpectedly short grid by itself. -->
        <Border x:Name="StatusFooter" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}"
                Background="{DynamicResource Surface}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke}" Padding="18,9">
            <Grid>
                <TextBlock Text="{Binding FooterCountText}" FontSize="11" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <ui:Button Content="Cancel shutdown" Appearance="Caution" Padding="12,2" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Command="{Binding CancelShutdownCommand}"
                           Visibility="{Binding IsShutdownPending, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- In-app dialogs (collections, feedback, confirmations, the command palette, ...): a dimmed layer over the whole window below
             the title bar, with the dialog as a card in the middle. MainWindow.Shell.cs shows and hides it. -->
        <Grid x:Name="ModalLayer" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="50"
              Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border x:Name="ModalScrim" Background="#B3000000" MouseLeftButtonDown="ModalScrim_MouseLeftButtonDown" />

            <Border x:Name="ModalCard" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource Ink}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <Grid x:Name="ModalHeader" DockPanel.Dock="Top" Margin="24,14,10,2">
                        <TextBlock x:Name="ModalTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                        <ui:Button x:Name="ModalCloseButton" Appearance="Transparent" Padding="7" HorizontalAlignment="Right"
                                   Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{Binding CloseTooltip, Source={x:Static services:ThemeState.Instance}}" Click="ModalClose_Click" />
                    </Grid>
                    <!-- A dialog taller than the window scrolls here instead of running off the bottom (see FitModalToWindow). -->
                    <ScrollViewer x:Name="ModalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="ModalContent" IsTabStop="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The on-screen keyboard the pad types with: over the page and over dialogs, under the focus ring. Shown only while a text box is being typed into. -->
        <local:OnScreenKeyboard x:Name="PadKeyboard" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="150" Visibility="Collapsed"
                                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,28" MaxWidth="1040" />

        <!-- Controller mode's focus ring: one ring, drawn over whatever control the pad is on, so every screen shows where the pad is (several controls draw no focus of their own).
             It sits above everything, takes no clicks, and is only shown while the pad is the thing in use. -->
        <Canvas x:Name="FocusRingLayer" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="200" IsHitTestVisible="False" Focusable="False">
            <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="White" BorderThickness="3" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#60A5FA" Opacity="0.9" />
                </Border.Effect>
            </Border>
        </Canvas>
    </Grid>
</ui:FluentWindow>
