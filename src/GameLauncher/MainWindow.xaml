<ui:FluentWindow x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        xmlns:vm="clr-namespace:GameLauncher.ViewModels"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Game Launcher" Height="720" Width="1180" MinHeight="480" MinWidth="760"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:LibraryViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStarConverter x:Key="BoolToStarConverter" />

        <!-- Simple, non-animated hover state (property-trigger only - no per-frame Storyboards)
             so idle CPU/GPU cost stays effectively zero while a game is running. -->
        <Style x:Key="GameCardStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Game Launcher" />

        <DockPanel Grid.Row="1" Margin="16,0,16,16">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" PlaceholderText="Search your library..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}" />

                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="160"
                          ItemsSource="{Binding SortOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SortOption}" />

                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Refresh"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}" />

                <ui:Button x:Name="SettingsButton" Grid.Column="3" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Settings24}"
                           ToolTip="Settings"
                           Click="SettingsButton_Click" />
            </Grid>

            <!-- Empty state: shown only when the library has genuinely nothing in it, not on a filtered search -->
            <Grid DockPanel.Dock="Top" Visibility="{Binding HasNoGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" MaxWidth="360">
                    <ui:SymbolIcon Symbol="Games24" FontSize="56" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="No games found yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Games are auto-detected from Steam, Epic and GOG, or add a folder to scan."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="Scan Now" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Add Folder" Icon="{ui:SymbolIcon FolderAdd24}" Appearance="Primary"
                                   Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoGames, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,16" Width="170">
                                <ui:Button Style="{StaticResource GameCardStyle}"
                                           Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid x:Name="TileRoot" Width="170" Height="226">
                                            <Border CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Image Source="{Binding Icon}" Width="88" Height="88"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Hover reveal: plain Visibility swap on a property trigger, no Storyboard/timer -->
                                            <Border x:Name="HoverOverlay" CornerRadius="8" Background="#99000000" Visibility="Collapsed">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="32" HorizontalAlignment="Center" Foreground="White" />
                                                    <TextBlock Text="Play" FontWeight="SemiBold" Foreground="White"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Margin="0,6,6,0" Padding="4" FontSize="13"
                                                       Appearance="Transparent"
                                                       Content="{Binding Favorite, Converter={StaticResource BoolToStarConverter}}"
                                                       ToolTip="Favorite"
                                                       Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="2,8,2,0" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" TextAlignment="Left"
                                                   HorizontalAlignment="Stretch" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55"
                                                   Margin="2,2,2,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="TileRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StatusBar Grid.Row="2" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="16,0" FontSize="12" Opacity="0.7" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
