<ui:FluentWindow x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        xmlns:vm="clr-namespace:GameLauncher.ViewModels"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        xmlns:services="clr-namespace:GameLauncher.Services"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Game Launcher" Height="760" Width="1180" MinHeight="480" MinWidth="760"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:LibraryViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStarConverter x:Key="BoolToStarConverter" />

        <!-- Hover/selection states are plain property triggers - no Storyboards or timers, so the
             app costs effectively nothing while idle or while a game is running. -->
        <!-- A bare-template plain Button, deliberately not ui:Button. WPF-UI's button paints its own
             square-cornered background in its normal AND hover visual states, which showed through
             the card's rounded corners as a pale hard-cornered frame. Setting Appearance,
             Background, BorderBrush and CornerRadius did not reach the hover layer. Stripping the
             template to a ContentPresenter removes every bit of that chrome for good - the card's
             own Border draws the entire visual, and HoverOverlay provides the hover feedback. -->
        <Style x:Key="GameCardStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Real cover art fills the tile edge-to-edge; a fallback exe icon stays small and centered
             so it isn't stretched into a blurry mess. -->
        <Style x:Key="GameArtImageStyle" TargetType="Image">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoverArt}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="NaN" />
                    <Setter Property="Stretch" Value="UniformToFill" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same reasoning as GameCardStyle: bare template, no third-party chrome to leak square
             corners or stray highlights into the caption strip. -->
        <Style x:Key="FavoriteStarStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Foreground" Value="#FFC83D" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One card definition shared by the Favorites section and the main library grid -->
        <DataTemplate x:Key="GameCardTemplate">
            <Button Style="{StaticResource GameCardStyle}"
                       Margin="0,0,12,14" Width="124"
                       Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <Border x:Name="CardRoot" CornerRadius="8" Background="#33000000">
                    <!-- Explicit clip so the caption strip's bottom corners round too, not just the art -->
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,124,216" RadiusX="8" RadiusY="8" />
                    </Border.Clip>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="124" Height="186">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Games24" FontSize="34" Opacity="0.35"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding Icon}"
                                           Style="{StaticResource GameArtImageStyle}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

            <!-- Platform badge: the launcher's own icon, or a small muted glyph when the source
                 is unknown - kept subtle so it marks the cover rather than blotting it out. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="5,5,0,0" Padding="2" CornerRadius="4"
                                    Background="#8C000000"
                                    ToolTip="{Binding Source, Converter={x:Static conv:GameSourceDisplayConverter.Instance}}">
                                <Grid Width="14" Height="14">
                                    <Image Source="{Binding PlatformIcon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ui:SymbolIcon Symbol="{Binding Source, Converter={x:Static conv:GameSourceToFallbackSymbolConverter.Instance}}"
                                                   FontSize="10" Foreground="#8CFFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding PlatformIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                </Grid>
                            </Border>

                            <!-- Running badge: mirrors the platform badge's placement, opposite corner -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,5,5,0" Padding="6,3" CornerRadius="4"
                                    Background="#8C000000"
                                    Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Running" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Hover reveal: Visibility swap on a property trigger, no animation loop -->
                            <Border x:Name="HoverOverlay" Background="#A6000000" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="28" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="Play" FontWeight="SemiBold" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Background="#CC0A0A0A" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="7,0,2,0" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip="{Binding Name}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <Button Grid.Column="1" Style="{StaticResource FavoriteStarStyle}"
                                       Margin="0,0,5,0"
                                       Content="{Binding Favorite, Converter={StaticResource BoolToStarConverter}}"
                                       ToolTip="Favorite"
                                       Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>

            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Collapses to a slim icon-only rail; DataTrigger keeps the width swap purely declarative,
             no converter or code-behind needed. -->
        <Style x:Key="SidebarStyle" TargetType="Border">
            <Setter Property="Width" Value="200" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Width" Value="52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pill row for each source toggle - a soft hover highlight ties it to the same rounded,
             card-driven language as the game grid instead of a bare list of switches. -->
        <Style x:Key="SidebarRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>

        <Style x:Key="SidebarToggleStyle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon" Visibility="Collapsed"
                        ToolTipText="Game Launcher"
                        TrayMouseDoubleClick="TrayIcon_Restore">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Game Launcher" Click="TrayIcon_Restore" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Title="Game Launcher" />

        <!-- Left sidebar: source toggles moved out of Settings since they're reached for far more
             often than the rest of that dialog - collapses to a bare rail to give the library room. -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SidebarStyle}"
                HorizontalAlignment="Left" Background="#14000000"
                BorderThickness="0,0,1,0" BorderBrush="#14FFFFFF">
            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                <ui:Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,10,10"
                           Appearance="Transparent" BorderThickness="0"
                           ToolTip="Collapse sidebar"
                           Command="{Binding ToggleSidebarCommand}">
                    <Grid Width="20" Height="20">
                        <ui:SymbolIcon Symbol="ChevronLeft24"
                                       Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <ui:SymbolIcon Symbol="ChevronRight24"
                                       Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </ui:Button>

                <!-- Big brand header while expanded - the sidebar's top slot, not a footer afterthought -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,18"
                            Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Image Source="/Assets/AppIcon.png" Width="96" Height="96"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
                    <TextBlock Text="Game Launcher" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Run Text="v" /><Run Text="{x:Static services:AppInfo.Version}" />
                    </TextBlock>
                </StackPanel>

                <!-- Edge-to-edge, unlike the indented rows below - a true full-bleed divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="#14FFFFFF" Margin="0,0,0,16"
                        Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                <StackPanel DockPanel.Dock="Top" Margin="10,0,10,0"
                            Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="SOURCES" FontWeight="SemiBold" FontSize="11" Opacity="0.5"
                               Margin="8,0,0,10"
                               Visibility="{Binding HasAnySourceGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasSteamGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="S" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding SteamIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding SteamIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Steam" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectSteam}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasEpicGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="E" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding EpicIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding EpicIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Epic Games" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectEpic}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasGogGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="G" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding GogIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding GogIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="GOG" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectGog}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasXboxGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <!-- The Xbox app's icon lives inside an ACL-locked MSIX package and can
                                     never be extracted by path, on any PC - so unlike the other sources
                                     this one skips the live-extraction attempt entirely and always shows
                                     a real, recognizable built-in Xbox controller glyph. -->
                                <ui:SymbolIcon Symbol="XboxController24" FontSize="14" Opacity="0.9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Xbox" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectXbox}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasEaGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="EA" FontSize="9" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding EaIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding EaIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="EA app" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectEa}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasUbisoftGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="U" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding UbisoftIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding UbisoftIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Ubisoft Connect" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectUbisoft}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasBattleNetGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="B" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding BattleNetIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding BattleNetIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Battle.net" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectBattleNet}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasRockstarGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="R" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding RockstarIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding RockstarIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Rockstar Games" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectRockstar}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SidebarRowStyle}"
                            Visibility="{Binding HasAmazonGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SidebarBadgeStyle}">
                                <Grid>
                                    <TextBlock Text="A" FontSize="11" FontWeight="Bold" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding AmazonGamesIcon, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <Image Source="{Binding AmazonGamesIcon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Amazon Games" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ui:ToggleSwitch Grid.Column="2" Style="{StaticResource SidebarToggleStyle}"
                                              IsChecked="{Binding DetectAmazonGames}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Drives: only the ones games actually live on, re-checked after every scan -->
                <StackPanel DockPanel.Dock="Top" Margin="10,20,10,0"
                            Visibility="{Binding IsSidebarExpanded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="DRIVES" FontWeight="SemiBold" FontSize="11" Opacity="0.5"
                               Margin="8,0,0,10"
                               Visibility="{Binding HasDrives, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Letter}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Opacity="0.6"
                                                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <Border Height="5" CornerRadius="3" Background="#1FFFFFFF" ClipToBounds="True">
                                            <Border HorizontalAlignment="Stretch" CornerRadius="3"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    RenderTransformOrigin="0,0">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding UsedFraction}" ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>

                                        <TextBlock Text="{Binding SummaryText}" FontSize="10" Opacity="0.55" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="20,4,20,12">
            <!-- Header row: library title on the left, controls on the right. Kept out of the title
                 bar so the control cluster can't overflow the caption buttons on a narrow window. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:TextBox Width="200" PlaceholderText="Search games..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                Background="#14FFFFFF" BorderThickness="0" />

                    <ComboBox Margin="10,0,0,0" MinWidth="130"
                              Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SortOption}" />

                    <ui:Button Margin="6,0,0,0" Appearance="Transparent" BorderThickness="0"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="Re-scan library"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}" />

                    <ui:Button x:Name="SettingsButton" Margin="2,0,0,0" Appearance="Transparent" BorderThickness="0"
                               Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="Settings"
                               Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Empty state: only when the library is genuinely empty, not when a search filters it out -->
            <Grid DockPanel.Dock="Top" Visibility="{Binding HasNoGames, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" MaxWidth="360">
                    <ui:SymbolIcon Symbol="Games24" FontSize="56" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="No games found yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Games are auto-detected from Steam, Epic, GOG and more, or add a folder to scan."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="Scan Now" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                                   IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                        <ui:Button Content="Add Folder" Icon="{ui:SymbolIcon FolderAdd24}" Appearance="Primary"
                                   Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoGames, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <!-- Favorites section - it and its divider disappear entirely when nothing is starred -->
                    <StackPanel Visibility="{Binding HasFavorites, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="Favorites" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12" />

                        <ItemsControl ItemsSource="{Binding FavoriteGames}"
                                      ItemTemplate="{StaticResource GameCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Separator Margin="0,4,0,20" Opacity="0.4" />
                    </StackPanel>

                    <TextBlock Text="{Binding LibraryHeaderText}" FontSize="17" FontWeight="SemiBold"
                               Margin="2,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Games}"
                                  ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="16,0" FontSize="12" Opacity="0.7" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
