<UserControl x:Class="GameLauncher.FeedbackDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d"
             Width="480">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="1" Margin="24,8,24,20" beh:Motion.FadeIn="True">
            <TextBlock Text="Tell us what's going on" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Bugs, wrong covers, missing games, ideas - anything. It goes straight to the developer."
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,14" />

            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                      DisplayMemberPath="Label" HorizontalAlignment="Stretch" Margin="0,0,0,10" />

            <ui:TextBox x:Name="MessageInput" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="What happened, or what would you like to see?"
                        AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                        MaxLength="{Binding MaxLength}" MinHeight="140" MaxHeight="220" Margin="0,0,0,10" />

            <ui:TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Contact (optional) - Discord name or email, if you want a reply"
                        MaxLength="100" Margin="0,0,0,12" />

            <CheckBox Content="Include technical details" IsChecked="{Binding IncludeDetails}" />
            <TextBlock Text="The app version, your Windows version and the last few error messages. No game library or personal files are sent."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="26,2,0,12" />

            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

            <Grid>
                <ui:Button Content="Report on GitHub instead" HorizontalAlignment="Left"
                           Command="{Binding OpenGitHubCommand}"
                           Visibility="{Binding ShowGitHubFallback, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Close" Click="Close_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Send" Appearance="Primary" Command="{Binding SendCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
