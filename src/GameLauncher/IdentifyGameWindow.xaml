<ui:FluentWindow x:Class="GameLauncher.IdentifyGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:GameLauncher.Converters"
        mc:Ignorable="d"
        Title="Identify Game" Height="640" Width="520" MinHeight="480" MinWidth="420"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Identify Game" />

        <!-- What the launcher currently believes, in words - and the detected title it is built from. A custom display
             name is never shown here as a search input: providers only ever see the detected title. -->
        <StackPanel Grid.Row="1" Margin="24,8,24,10">
            <TextBlock FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding GameName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock FontSize="11" Opacity="0.55" Margin="0,2,0,0">
                <Run Text="Detected as: " /><Run Text="{Binding DetectedTitle, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Your custom cover is kept whatever you choose here."
                       FontSize="11" Opacity="0.55" Margin="0,2,0,0"
                       Visibility="{Binding HasPinnedCover, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="24,0,24,8">
            <!-- ================= Identify game ================= -->
            <TabItem Header="Identify game" x:Name="IdentifyTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search by title"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="Search" Margin="8,0,0,0"
                                   Command="{Binding SearchCommand}" />
                    </Grid>

                    <ListBox x:Name="CandidateList" Grid.Row="1" ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedCandidate}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="69" CornerRadius="4" Background="#1FFFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="This is the game" Appearance="Primary"
                                   Command="{Binding ConfirmCommand}" />
                        <ui:Button Content="Not this game" Margin="8,0,0,0"
                                   Command="{Binding RejectCommand}"
                                   ToolTip="Never pick the selected game (or, with nothing selected, the automatic match) for this entry again" />
                        <ui:Button Content="Clear identity" Margin="8,0,0,0"
                                   Command="{Binding ClearCommand}"
                                   IsEnabled="{Binding CanClear}"
                                   ToolTip="Forget your choices for this game and go back to automatic identification" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= Choose cover ================= -->
            <TabItem Header="Choose cover" x:Name="CoverTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8"
                               Text="Covers listed for the game this is identified as. Picking a cover sets a custom cover - it does not change which game this is." />

                    <ListBox x:Name="CoverList" Grid.Row="1" ItemsSource="{Binding Covers}"
                             SelectedItem="{Binding SelectedCover}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="104" Margin="4">
                                    <!-- Stretch="Uniform", matching GameCardTemplate.xaml's GameArtImageStyle: the card that will actually
                                         display whichever cover is picked here never crops (some real covers - SteamGridDB banners in
                                         particular - aren't that same shape), so this thumbnail must show the same full, letterboxed
                                         image, not a different, cropped preview of it. 100x130 matches the card's current 200x260
                                         art ratio exactly. -->
                                    <Border Width="100" Height="130" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" FontSize="10" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Load covers" Command="{Binding LoadCoversCommand}" />
                        <ui:Button Content="Use this cover" Appearance="Primary" Margin="8,0,0,0"
                                   Command="{Binding ApplyCoverCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Opacity="0.85" />
            <ui:Button Grid.Column="1" Content="Close" Margin="12,0,0,0" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
