<UserControl x:Class="GameLauncher.CollectionsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             xmlns:services="clr-namespace:GameLauncher.Services"
             mc:Ignorable="d"
             Width="420" Height="440">

    <!-- Tick the collections a game belongs to, or type a new one (spec 03 section 3.8, 04 section 4.7, 05 section 5.6): check rows in Axis, square-check rows
         in Console-tile's sheet, glowing toggle chips with a tick in Console-ribbon. The bindings are the same in all three. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Axis: a check box row with the game count on the right -->
            <DataTemplate x:Key="AxisChoice">
                <CheckBox IsChecked="{Binding IsMember, Mode=TwoWay}" Height="38" Padding="8,0" Margin="0,0,0,2">
                    <Grid Width="320">
                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </CheckBox>
            </DataTemplate>

            <!-- Console-tile: a 48 px row on a faint panel, a square check, a 2 px white ring on hover -->
            <DataTemplate x:Key="TileChoice">
                <Border x:Name="Row" Height="48" CornerRadius="4" Background="#0DFFFFFF" Margin="0,0,0,6">
                    <Grid>
                        <CheckBox IsChecked="{Binding IsMember, Mode=TwoWay}" Padding="14,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0">
                            <Grid Width="280">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </CheckBox>
                        <Border x:Name="Ring" CornerRadius="4" BorderBrush="White" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Console-ribbon: a toggle chip; when on it is lit blue, glows and shows a tick before the name -->
            <DataTemplate x:Key="RibbonChoice">
                <ToggleButton IsChecked="{Binding IsMember, Mode=TwoWay}" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}" Height="38">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Glow" beh:ThemeRadius.Key="Pill" Background="#0F1117" Opacity="0" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="#60A5FA" Opacity="0.6" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="Body" beh:ThemeRadius.Key="Pill" Background="#0AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="Tick" Symbol="Checkmark24" FontSize="14" Margin="0,0,8,0" Visibility="Collapsed" Foreground="White" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Ring" beh:ThemeRadius.Key="Pill" BorderBrush="White" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="#2960A5FA" />
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#B360A5FA" />
                                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="StackChoices"><StackPanel /></ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="WrapChoices"><WrapPanel /></ItemsPanelTemplate>

            <Style x:Key="ChoiceList" TargetType="ItemsControl">
                <Setter Property="ItemTemplate" Value="{StaticResource AxisChoice}" />
                <Setter Property="ItemsPanel" Value="{StaticResource StackChoices}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="ItemTemplate" Value="{StaticResource TileChoice}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRibbon, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="ItemTemplate" Value="{StaticResource RibbonChoice}" />
                        <Setter Property="ItemsPanel" Value="{StaticResource WrapChoices}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The new-collection box: a rounded field whose frame, height and focus ring come from the theme. -->
            <Style x:Key="NewNameStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="{DynamicResource InputHeight}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Glow" beh:ThemeRadius.Key="RadiusInput" Background="{DynamicResource Bg}" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource ToggleGlowEffect}" />
                                <Border x:Name="Frame" beh:ThemeRadius.Key="RadiusInput" Background="{DynamicResource InputFill}" BorderBrush="{DynamicResource InputStroke}" BorderThickness="1">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Hint" Text="New collection name" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border x:Name="FocusRing" beh:ThemeRadius.Key="RadiusInput" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,8,24,10">
            <TextBlock Text="{Binding GameName}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True">
                                <Setter Property="FontSize" Value="24" />
                                <Setter Property="FontWeight" Value="ExtraBold" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRibbon, Source={x:Static services:ThemeState.Instance}}" Value="True">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Pick the categories this game belongs to, or add your own below." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,0,24,8" VerticalScrollBarVisibility="Auto" beh:Motion.FadeIn="True">
            <StackPanel>
                <TextBlock Text="No collections yet - type a name below to start one." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding HasChoices, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Choices}" Style="{StaticResource ChoiceList}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewNameBox" Grid.Column="0" Style="{StaticResource NewNameStyle}" MaxLength="40" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Command="{Binding AddNewCommand}" />
        </Grid>

        <!-- Footer: Cancel and Save, laid out per theme -->
        <Grid Grid.Row="3" Margin="24,0,24,20">
            <StackPanel x:Name="StandardFooter" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" Click="Save_Click" />
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>

            <!-- Console-tile: two equal-width buttons, 42 high -->
            <Grid x:Name="TileFooter">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Height="42" HorizontalAlignment="Stretch" FontSize="14" FontWeight="Bold" />
                <ui:Button Grid.Column="2" Content="Save" Appearance="Primary" Click="Save_Click" Height="42" HorizontalAlignment="Stretch" FontSize="14" FontWeight="Bold" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
