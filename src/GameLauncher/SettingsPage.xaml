<UserControl x:Class="GameLauncher.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:services="clr-namespace:GameLauncher.Services"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             xmlns:local="clr-namespace:GameLauncher"
             xmlns:controls="clr-namespace:GameLauncher.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A group of related settings: one rounded card per group, titled, instead of one long undivided scroll. -->
            <Style x:Key="GroupCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GroupCardFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GroupCardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="beh:ThemeRadius.Key" Value="RadiusPanel" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightPageTitle}" />
                <Setter Property="Margin" Value="2,0,0,4" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionNoteStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,0,0,16" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <!-- A category's content column: centred in its area. The console styles let it shrink to its content; Axis gives every category the same
                 width (a stretched element capped by its MaxWidth sits in the middle), so the cards line up from one category to the next. -->
            <Style x:Key="SectionBodyStyle" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAxis, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NoteStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,5,0,0" />
            </Style>
            <Style x:Key="RowGapStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource Stroke}" />
                <Setter Property="Margin" Value="0,14" />
            </Style>
            <!-- Category items. Content is the label and Tag the icon's name, so each theme can draw them its own way: a row with an accent marker
                 (Axis), a square tile with a wrapping label (Console-tile), a glowing pill (Console-ribbon). -->
            <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid MinHeight="36">
                                <Border x:Name="Root" beh:ThemeRadius.Key="RadiusNavItem" Background="Transparent" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock Text="{TemplateBinding Content}" Margin="10,0,0,0" FontSize="13" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Ring" beh:ThemeRadius.Key="RadiusNavItem" BorderBrush="{DynamicResource FocusInk}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TileCategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Width" Value="{DynamicResource ActiveSettingsTileWidth}" />
                <Setter Property="Height" Value="{DynamicResource ActiveSettingsTileHeight}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Root" beh:ThemeRadius.Key="RadiusPanel" Background="#E61A1D27" Padding="12,10">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" Foreground="{TemplateBinding Foreground}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                                <Border x:Name="Ring" beh:ThemeRadius.Key="RadiusPanel" BorderBrush="White" BorderThickness="3" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource InverseFill}" />
                                    <Setter Property="Foreground" Value="{DynamicResource InverseInk}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PillCategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Height="40">
                                <Border x:Name="Glow" beh:ThemeRadius.Key="Pill" Background="{DynamicResource Bg}" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource ToggleGlowEffect}" />
                                <Border x:Name="Root" beh:ThemeRadius.Key="Pill" Background="Transparent" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock Text="{TemplateBinding Content}" Margin="10,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Ring" beh:ThemeRadius.Key="Pill" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#0AFFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The category list: a vertical list (Axis), tiles in a wrapping row above the content (Console-tile), a vertical list of pills (Console-ribbon). -->
            <Style x:Key="CategoryListStyle" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryItemStyle}" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Setter Property="Margin" Value="0,4,24,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="ItemContainerStyle" Value="{StaticResource TileCategoryItemStyle}" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Margin" Value="0,0,0,18" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRibbon, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="ItemContainerStyle" Value="{StaticResource PillCategoryItemStyle}" />
                        <Setter Property="Margin" Value="0,4,28,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionHostStyle" TargetType="Grid">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTile, Source={x:Static services:ThemeState.Instance}}" Value="True">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Categories on the left, one category at a time on the right - no endless scroll. Every setting from before is still here, just grouped. -->
    <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource ActiveSettingsNavColumn}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox x:Name="CategoryList" Style="{StaticResource CategoryListStyle}"
                 SelectionChanged="CategoryList_SelectionChanged">
            <ListBoxItem x:Name="GeneralCategory" AutomationProperties.Name="General" Tag="Settings24" Content="General" />
            <ListBoxItem x:Name="LibraryCategory" AutomationProperties.Name="Library" Tag="Folder24" Content="Library" />
            <ListBoxItem x:Name="AppearanceCategory" AutomationProperties.Name="Appearance" Tag="PaintBrush24" Content="Appearance" />
            <ListBoxItem x:Name="PerformanceCategory" AutomationProperties.Name="Performance" Tag="Flash24" Content="Performance" />
            <ListBoxItem x:Name="BackupCategory" AutomationProperties.Name="Data and backup" Tag="Save24" Content="Data and backup" />
            <ListBoxItem x:Name="AboutCategory" AutomationProperties.Name="About and support" Tag="Info24" Content="About and support" />
        </ListBox>

        <!-- The seven category panels share one cell; SettingsPage.xaml.cs shows the chosen one. Each scrolls on its own. -->
        <Grid x:Name="SectionHost" Style="{StaticResource SectionHostStyle}">

            <!-- ================= General ================= -->
            <ScrollViewer x:Name="GeneralSection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="General" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="How the launcher starts, how it behaves while you play, how play time is kept, and how you reach it." Style="{StaticResource SectionNoteStyle}" />

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Startup" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Text="Open Axis Game Launcher when you sign in. On by default for a new install. Keep a portable copy in a permanent location before enabling this."
                                       Style="{StaticResource NoteStyle}" />
                            <Border Style="{StaticResource RowGapStyle}" />
                            <ui:ToggleSwitch Content="Open maximized" IsChecked="{Binding StartMaximized}" />
                            <TextBlock Text="Fill the screen when the launcher opens. Turn off to open at a normal window size."
                                       Style="{StaticResource NoteStyle}" />
                            <Border Style="{StaticResource RowGapStyle}" />
                            <ui:ToggleSwitch Content="Check for updates on startup" IsChecked="{Binding CheckForUpdates}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Minimize button" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Minimize to tray" IsChecked="{Binding MinimizeToTrayOnMinimize}" />
                            <TextBlock Text="When you press the minimize button, hide the launcher in the system tray instead of the taskbar. Double-click the tray icon to bring it back. Off by default."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="While you play" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Hide to tray while gaming" IsChecked="{Binding MinimizeToTrayWhileGaming}" />
                            <TextBlock Text="While a game is running, hide to the system tray and come back automatically when it closes. When off, the launcher just minimizes to the taskbar."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Play time" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Track games opened outside the launcher" IsChecked="{Binding TrackExternalGames}" />
                            <TextBlock Text="While Axis Game Launcher is running, detect known game executables and track their running time. No earlier play history is imported. Protected games without a readable executable path may not be detected. This does not hide or restore the launcher."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}" Visibility="{Binding ShortcutsEnabled, Source={x:Static services:ThemeState.Instance}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Press Ctrl+K in the launcher to find a game or run any command by typing." FontSize="13" TextWrapping="Wrap" />
                            <Border Style="{StaticResource RowGapStyle}" />
                            <ui:ToggleSwitch Content="Open the command palette from anywhere with Ctrl+Alt+Space" IsChecked="{Binding GlobalHotkeyEnabled}" />
                            <TextBlock Text="Brings the launcher forward, even from the tray or while a game is open. Turn off if another program already uses that shortcut."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Library ================= -->
            <ScrollViewer x:Name="LibrarySection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="Library" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Where your games come from, and how they are scanned." Style="{StaticResource SectionNoteStyle}" />

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Watched folders" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Games are auto-detected from Steam, Epic, GOG and more. Add folders below for anything else."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,10" />

                            <ListBox ItemsSource="{Binding WatchedFolders}" BorderThickness="0" Background="Transparent" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding Path}" FontSize="12" />
                                            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="4"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ui:Button Content="Add folder" Command="{Binding AddFolderCommand}"
                                       Icon="{ui:SymbolIcon FolderAdd24}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Drives to search" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Switch a drive off and nothing on it is searched, and its games leave your library until you switch it back on."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="DriveSearchList" ItemsSource="{Binding SearchableDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSearched}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,12" />
                            <ui:ToggleSwitch x:Name="FindWithoutLauncherSwitch" Content="Find games installed without a launcher" IsChecked="{Binding FindGamesWithoutLauncher}" />
                            <TextBlock Text="Pre-installed and repacked games, or a game folder copied from another PC, are recognised on the drives above and shown under No launcher. Only folder names are looked at; nothing is opened or read."
                                       Style="{StaticResource NoteStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Scanning" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Rescan after installing new games, or add a shortcut to launch Axis Game Launcher from your desktop."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <ui:Button Margin="0,0,10,8" Content="Rescan library" Appearance="Primary"
                                           Command="{Binding RescanCommand}"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           IsEnabled="{Binding IsLoading, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                <ui:Button Content="{Binding DesktopShortcutButtonText}"
                                           Command="{Binding CreateDesktopShortcutCommand}"
                                           Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,10,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Cover art" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Real box art is fetched automatically for every source - Steam through its own store, everything else through IGDB (SteamGridDB as a fallback). Nothing to set up, no account needed."
                                       FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Appearance ================= -->
            <ScrollViewer x:Name="AppearanceSection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="How the launcher looks." Style="{StaticResource SectionNoteStyle}" />

                    <!-- The theme: three option cards. Choosing one re-dresses the whole window at once and keeps this page open. -->
                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Theme" Style="{StaticResource GroupTitleStyle}" Margin="0" VerticalAlignment="Center" />
                                <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="9" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="New" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Changes navigation, cards, menus and motion as well as colour. Your library, collections and settings stay the same."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,14" />
                            <local:ThemePicker x:Name="ThemeChoices" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Background" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch x:Name="VibrantSwitch" Content="Vibrant background" IsChecked="{Binding VibrantBackground}" IsEnabled="{Binding IsAxisTheme}" />
                            <TextBlock Text="Frosted acrylic background. Uses a little GPU while the window is on screen - nothing while it's minimized during a game."
                                       Style="{StaticResource NoteStyle}" />
                            <TextBlock Text="Not used by this theme." Style="{StaticResource NoteStyle}" FontWeight="SemiBold"
                                       Visibility="{Binding IsConsoleTheme, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!-- Only in the PlayStation theme: controller mode is a mode of that theme. -->
                    <Border x:Name="ControllerCard" Style="{StaticResource GroupCardStyle}"
                            Visibility="{Binding ControllerModeAvailable, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="Controller mode" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch x:Name="ControllerSwitch" Content="Use the launcher with a controller" IsChecked="{Binding IsControllerMode, Mode=TwoWay}" />
                            <TextBlock Text="Full screen and a little bigger, driven by a gamepad: D-pad or left stick to move, A to choose, B to go back. Xbox controllers work as they are; a PlayStation controller needs Steam Input or DS4Windows. The controller is ignored whenever a game (or another window) is in front."
                                       Style="{StaticResource NoteStyle}" />

                            <Border Style="{StaticResource RowGapStyle}" />
                            <TextBlock Text="Button mapping" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" />
                            <TextBlock Text="A and B never change, and the D-pad and left stick always move. Press a button's row to give that button another job; press again for the next one, and it comes back round to its default. A job can be on one button only: one that another button already has is skipped."
                                       Style="{StaticResource NoteStyle}" />
                            <!-- The buttons that never change, drawn as they look on the pad. -->
                            <StackPanel x:Name="ControllerFixedButtons" Margin="0,8,0,4">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PadGlyphView Glyph="A" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"><Run Text="Choose" FontWeight="SemiBold" /><Run Text="  -  always" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PadGlyphView Glyph="B" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"><Run Text="Back" FontWeight="SemiBold" /><Run Text="  -  always" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PadGlyphView Glyph="RightStick" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"><Run Text="Scroll" FontWeight="SemiBold" /><Run Text="  -  always" Foreground="{DynamicResource Muted}" /></TextBlock>
                                </Grid>
                            </StackPanel>
                            <ItemsControl x:Name="ControllerButtonList" ItemsSource="{Binding ControllerButtonRows}" Focusable="False" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:PadGlyphView Glyph="{Binding Glyph}" HorizontalAlignment="Left" />
                                            <ui:Button Grid.Column="1" MinWidth="230" HorizontalContentAlignment="Left" Content="{Binding FunctionText}"
                                                       Command="{Binding DataContext.CycleControllerButtonCommand, RelativeSource={RelativeSource AncestorType=local:SettingsPage}}"
                                                       CommandParameter="{Binding}" ToolTip="Press to give this button another job"
                                                       AutomationProperties.Name="{Binding ButtonName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button x:Name="ControllerResetButton" Content="Reset buttons to default" Command="{Binding ResetControllerButtonsCommand}" Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                       HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Performance ================= -->
            <ScrollViewer x:Name="PerformanceSection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="Performance" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Free up memory and clear storage clutter - sizes are shown first, and you are asked before anything is deleted."
                               Style="{StaticResource SectionNoteStyle}" />

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Optimize" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Trim idle memory and clear temporary files, caches and the Recycle Bin from one page." Style="{StaticResource NoteStyle}" Margin="0,0,0,12" />
                            <ui:Button Content="Open Optimize" Command="{Binding ShowOptimizeCommand}"
                                       Icon="{ui:SymbolIcon Flash24}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Before a game starts" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Free up memory before launching a game" IsChecked="{Binding OptimizeBeforeLaunch}" />
                            <TextBlock Text="Trims other apps' idle memory just before a game starts. Never closes anything."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Focus play" Style="{StaticResource GroupTitleStyle}" />
                            <ui:ToggleSwitch Content="Use a high performance power plan while a game runs" IsChecked="{Binding FocusPlayEnabled}" IsEnabled="{Binding FocusPlayAvailable}" />
                            <TextBlock Text="{Binding FocusPlayStatusText}" Style="{StaticResource NoteStyle}" Foreground="{DynamicResource Danger}"
                                       Visibility="{Binding HasFocusPlayStatus, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="Switches Windows to a high performance power plan when you launch a game from here, and back to your own plan when the game closes (or if this app is closed or restarted). Nothing is closed or changed besides the plan. A game can also be set to run at High priority from its details page."
                                       Style="{StaticResource NoteStyle}" />
                            <Border Style="{StaticResource RowGapStyle}" />
                            <ui:ToggleSwitch Content="Only when plugged in" IsChecked="{Binding FocusPlayOnlyWhenPluggedIn}" IsEnabled="{Binding FocusPlayAvailable}" />
                            <TextBlock Text="On a laptop running on battery the power plan is left alone."
                                       Style="{StaticResource NoteStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Data and backup ================= -->
            <ScrollViewer x:Name="BackupSection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="Data and backup" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Keep your own data safe, or move it to another PC." Style="{StaticResource SectionNoteStyle}" />

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Library data" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="Save your favorites, hidden games, collections, notes, custom names, tracked play time and preferences to a file - to keep safe or move to another PC. Cover art, keys and folder paths are not included."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <ui:Button Margin="0,0,10,8" Content="Export library data..." Command="{Binding ExportLibraryDataCommand}"
                                           Icon="{ui:SymbolIcon ArrowUpload24}" />
                                <ui:Button Content="Import library data..." Command="{Binding ImportLibraryDataCommand}"
                                           Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,10,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Cache and reset" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="After an update a saved cover can be out of date. Clearing the cache removes the saved cover art and icons and looks every cover up again. Resetting also puts every setting back to its default. Your favorites, hidden games, collections, notes, play time, watched folders and the covers you chose yourself are kept either way."
                                       Style="{StaticResource NoteStyle}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <ui:Button Margin="0,0,10,8" Content="Clear cache and refresh covers" Command="{Binding ClearCacheCommand}"
                                           Icon="{ui:SymbolIcon ArrowSync24}" />
                                <ui:Button Content="Reset all settings and cache..." Command="{Binding ResetEverythingCommand}"
                                           Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,10,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= About and support ================= -->
            <ScrollViewer x:Name="AboutSection" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" Visibility="Collapsed">
                <StackPanel MaxWidth="{DynamicResource PageBodyMaxWidth}" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock Text="About and support" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource SectionNoteStyle}">
                        <Run Text="Axis Game Launcher &#8226; Version " /><Run Text="{x:Static services:AppInfo.Version}" />
                    </TextBlock>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="The launcher checks when it starts (change that under General). You can also check right now." Style="{StaticResource NoteStyle}" Margin="0,0,0,12" />
                            <ui:Button Content="Check for Updates Now" Command="{Binding CheckForUpdateNowCommand}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Help" Style="{StaticResource GroupTitleStyle}" />
                            <WrapPanel>
                                <ui:Button Margin="0,0,10,8" Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}"
                                           Icon="{ui:SymbolIcon DocumentText24}" />
                                <ui:Button Content="Send Feedback or Report a Bug" Command="{Binding ReportBugCommand}"
                                           Icon="{ui:SymbolIcon Bug24}" Margin="0,0,10,8"
                                           ToolTip="Tell the developer about a bug, a wrong cover, or an idea - no account needed." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
