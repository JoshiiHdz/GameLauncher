<UserControl x:Class="GameLauncher.MyPcPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One section: a small icon heading and tight label / value rows. The explanatory line a row used to carry is its tooltip. -->
            <DataTemplate x:Key="SectionTemplate">
                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static conv:SymbolNameConverter.Instance}}" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1" Background="Transparent" ToolTip="{Binding Hint}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,1,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- My PC: what is inside this computer, in cards (see SystemInfoService). The page's data is the snapshot itself. -->
    <ScrollViewer Margin="0,8,0,8" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" beh:Motion.FadeIn="True">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,260,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="CopyButton" Content="Copy all" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" ToolTip="Copy everything on this page as text" />
                    <ui:Button x:Name="RefreshButton" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Read the PC again" />
                </StackPanel>
            </Grid>

            <!-- One compact panel, no cards: the sections are dealt into two or three even columns (by how many lines they have) under a small icon heading each. -->
            <Border Style="{StaticResource GroupCard}" Padding="18,12,18,2">
                <ItemsControl x:Name="SectionColumns" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False" Margin="0,0,20,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
