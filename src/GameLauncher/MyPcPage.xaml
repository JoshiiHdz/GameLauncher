<UserControl x:Class="GameLauncher.MyPcPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:GameLauncher.Behaviors"
             xmlns:conv="clr-namespace:GameLauncher.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- My PC: what is inside this computer, in cards (see SystemInfoService). The page's data is the snapshot itself. -->
    <ScrollViewer Margin="0,8,0,8" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" beh:Motion.FadeIn="True">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,260,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="CopyButton" Content="Copy all" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" ToolTip="Copy everything on this page as text" />
                    <ui:Button x:Name="RefreshButton" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Read the PC again" />
                </StackPanel>
            </Grid>

            <!-- One compact panel: the sections flow side by side under a small icon heading each, with tight rows. The explanatory line each row used to carry is its tooltip. -->
            <Border Style="{StaticResource GroupCard}" Padding="20,16,0,2">
                <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="308" Margin="0,0,22,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static conv:SymbolNameConverter.Instance}}" FontSize="17" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,7" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3" Background="Transparent" ToolTip="{Binding Hint}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,1,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
