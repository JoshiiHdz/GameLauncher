<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows + UseWPF, not plain net8.0: tests need access to the WPF imaging types
         (BitmapImage) that CoverArtDecoder decodes to, and a project reference to the main WinExe
         app project pulls in its net8.0-windows target either way. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real WebP files (generated by Fixtures\WebP\generate_fixtures.py) for ProviderWebpTests. -->
    <EmbeddedResource Include="Fixtures\WebP\*.webp" LogicalName="Fixtures.WebP.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit runs async tests on a pool of as many worker threads as there are CPU cores. Several tests here block a worker on purpose (a stalled
         response body, a real subprocess, a TLS handshake) while other tests await a free worker to resume on; on a small machine (a 2-4 core CI
         runner) every worker ends up blocked and the whole run hangs. A FIXED pool of 8 removes that starvation without oversubscribing the CPU:
         measured on 4 and 2 cores, 8 passes every run, 6 still lets timing tests miss their deadlines, and unlimited workers oversubscribes so
         badly that the tests which assert a wall-clock budget fail. The tests themselves are unchanged. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameLauncher\GameLauncher.csproj" />
  </ItemGroup>

</Project>
