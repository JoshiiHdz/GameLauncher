<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows + UseWPF, not plain net8.0: tests need access to the WPF imaging types
         (BitmapImage) that CoverArtDecoder decodes to, and a project reference to the main WinExe
         app project pulls in its net8.0-windows target either way. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real WebP files (generated by Fixtures\WebP\generate_fixtures.py) for ProviderWebpTests. -->
    <EmbeddedResource Include="Fixtures\WebP\*.webp" LogicalName="Fixtures.WebP.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test collections run ONE AT A TIME. Many tests here assert a wall-clock budget (a stalled response body must be abandoned within its
         deadline, a subprocess must finish promptly) or block a worker on purpose (a stalled stream, a real subprocess, a TLS handshake).
         Run in parallel on a small machine (a 2-4 core CI runner) they either exhaust xUnit's core-sized worker pool and hang the whole run, or
         starve each other of CPU and miss their deadlines - reproduced by pinning the run to 1-4 cores; a bounded or unbounded pool only moved the
         failures around. Sequential takes ~80 s instead of ~47 s and passes on 2 and 4 cores. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameLauncher\GameLauncher.csproj" />
  </ItemGroup>

</Project>
